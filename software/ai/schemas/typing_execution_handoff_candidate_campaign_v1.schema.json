{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rocell.local/schemas/typing_execution_handoff_candidate_campaign_v1.schema.json",
  "title": "RoCell execution handoff candidate campaign v1",
  "type": "object",
  "required": ["schema", "campaign_id", "environment", "reference_candidate_sha256", "case_count", "cases", "campaign_sha256"],
  "properties": {
    "schema": {"const": "rocell.typing_execution_handoff_candidate_campaign.v1"},
    "campaign_id": {"type": "string", "minLength": 1},
    "environment": {"type": "object"},
    "reference_candidate_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "case_count": {"const": 8},
    "cases": {"type": "array", "minItems": 8, "maxItems": 8},
    "campaign_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
