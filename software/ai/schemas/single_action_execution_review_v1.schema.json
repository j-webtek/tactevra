{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rocell.local/schemas/single_action_execution_review_v1.schema.json",
  "title": "RoCell single action execution review v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "status", "review_id", "batch_sha256", "action_index",
    "proposal_v2_sha256", "device", "interaction",
    "trajectory_execution_envelope_v2_sha256",
    "contact_envelope_gate_sha256",
    "installed_collision_policy_qualification_sha256",
    "installed_controller_qualification_evidence_sha256",
    "installed_controller_qualification_report_sha256",
    "t102_command_profile_sha256", "reviewed_t102_goal",
    "reviewed_t102_goal_sha256",
    "configuration_epoch_sha256", "controller_session_id",
    "issued_monotonic_ns", "deadline_monotonic_ns", "single_use_required",
    "permit_issued", "automatic_retry_allowed", "controller_commands",
    "wire_commands", "hardware_access", "physical_authority",
    "contact_authority", "review_sha256"
  ],
  "properties": {
    "schema": {"const": "rocell.single_action_execution_review.v1"},
    "status": {"const": "REVIEWED_FOR_SINGLE_USE_DOWNSTREAM_PERMIT"},
    "review_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "batch_sha256": {"$ref": "#/$defs/hash"},
    "action_index": {"type": "integer", "minimum": 0, "maximum": 63},
    "proposal_v2_sha256": {"$ref": "#/$defs/hash"},
    "device": {"enum": ["keyboard", "phone"]},
    "interaction": {"enum": ["HOVER", "CONTACT"]},
    "trajectory_execution_envelope_v2_sha256": {"$ref": "#/$defs/hash"},
    "contact_envelope_gate_sha256": {"$ref": "#/$defs/hash"},
    "installed_collision_policy_qualification_sha256": {"$ref": "#/$defs/hash"},
    "installed_controller_qualification_evidence_sha256": {"$ref": "#/$defs/hash"},
    "installed_controller_qualification_report_sha256": {"$ref": "#/$defs/hash"},
    "t102_command_profile_sha256": {"$ref": "#/$defs/hash"},
    "reviewed_t102_goal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["T", "base", "shoulder", "elbow", "wrist", "roll", "hand", "spd", "acc"],
      "properties": {
        "T": {"const": 102},
        "base": {"type": "number"}, "shoulder": {"type": "number"},
        "elbow": {"type": "number"}, "wrist": {"type": "number"},
        "roll": {"type": "number"}, "hand": {"type": "number"},
        "spd": {"type": "integer", "minimum": 1, "maximum": 65535},
        "acc": {"type": "integer", "minimum": 1, "maximum": 255}
      }
    },
    "reviewed_t102_goal_sha256": {"$ref": "#/$defs/hash"},
    "configuration_epoch_sha256": {"$ref": "#/$defs/hash"},
    "controller_session_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "issued_monotonic_ns": {"type": "integer", "minimum": 1},
    "deadline_monotonic_ns": {"type": "integer", "minimum": 1},
    "single_use_required": {"const": true},
    "permit_issued": {"const": false},
    "automatic_retry_allowed": {"const": false},
    "controller_commands": {"type": "array", "maxItems": 0},
    "wire_commands": {"type": "array", "maxItems": 0},
    "hardware_access": {"const": false},
    "physical_authority": {"const": false},
    "contact_authority": {"const": false},
    "review_sha256": {"$ref": "#/$defs/hash"}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
