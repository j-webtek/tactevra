{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tactevra.local/schemas/residual_obstruction_successor_fixture_v4.schema.json",
  "title": "Residual obstruction reference-comparison successor fixture v4",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "scope", "source", "base_scenes", "appearances", "variants", "reference_contract", "split_policy", "render_admission", "training_plan", "pretraining_gates", "development_gate", "images_generated", "training_started", "development_opened", "evaluation_opened", "hardware_writes", "physical_movements", "physical_authority", "limitations", "bundle_sha256"],
  "properties": {
    "schema": {"const": "tactevra.ai_residual_obstruction_successor_fixture.v4"},
    "scope": {"const": "SYNTHETIC_ISAAC_REFERENCE_COMPARISON_PREDECLARATION_NO_QUALIFICATION"},
    "source": {"type": "object", "required": ["practice_manifest_file_sha256", "practice_corpus_sha256", "target_catalog_sha256", "training_audit_file_sha256", "training_audit_report_sha256", "visual_review_file_sha256", "visual_review_sha256", "rejected_model_sha256"]},
    "base_scenes": {"type": "array", "minItems": 28, "maxItems": 28, "items": {"type": "object", "required": ["scene_id", "split", "isaac_seed", "render_phase", "fresh_render_required", "source_image_reuse_prohibited", "commissioned_park_pose", "camera_pose_jitter_mm", "camera_rotation_jitter_deg", "fixture_surface_randomization"]}},
    "appearances": {"type": "array", "minItems": 12, "maxItems": 12, "items": {"type": "object", "required": ["appearance_id", "split", "lighting_seed", "family", "color_temperature_k", "illuminance_lux", "exposure_multiplier", "paired_across_variants"]}},
    "variants": {"type": "array", "minItems": 12, "maxItems": 12},
    "reference_contract": {"type": "object", "required": ["reference_kind", "one_reference_per_scene_and_target", "reference_variant", "reference_appearance", "reference_must_precede_observation", "reference_and_observation_camera_transform_identical", "reference_rgb_reuse_within_scene_target_is_intentional", "observation_rgb_must_be_unique", "runtime_reference_source", "missing_or_stale_reference_decision"]},
    "split_policy": {"type": "object", "required": ["scene_ids_disjoint", "appearance_ids_disjoint", "lighting_seeds_disjoint", "reference_ids_disjoint", "training_scene_count", "development_scene_count", "evaluation_scene_count", "training_pair_count", "development_pair_count", "planned_evaluation_pair_count", "evaluation_pairs_rendered", "evaluation_render_requires_development_pass", "evaluation_is_single_use"]},
    "render_admission": {"type": "object"},
    "training_plan": {"type": "object", "required": ["algorithm", "model_inputs", "input_channels", "input_size_px", "convolution_channels", "spatial_pool_output", "global_average_pooling_prohibited", "normalization", "development_or_evaluation_statistics_prohibited", "epochs", "batch_size", "optimizer", "learning_rate", "weight_decay", "seed", "sampling", "threshold_candidates"]},
    "pretraining_gates": {"type": "object", "required": ["identity_geometry_baseline_auc_maximum", "memorization_subset_count", "memorization_loss_maximum", "memorization_accuracy_minimum", "full_training_prohibited_until_memorization_passes"]},
    "development_gate": {"type": "object", "required": ["missed_obstruction_rate_upper", "visible_false_stop_rate_upper", "confidence_level", "base_scene_cluster_bootstrap_resamples", "base_scene_cluster_bootstrap_seed", "minimum_per_target_auc", "minimum_per_target_strict_margin", "every_target_must_pass_auc_and_margin", "worst_appearance_must_pass", "worst_variant_family_must_pass", "point_and_cluster_upper_bounds_must_pass", "evaluation_must_remain_unopened"]},
    "images_generated": {"const": false},
    "training_started": {"const": false},
    "development_opened": {"const": false},
    "evaluation_opened": {"const": false},
    "hardware_writes": {"const": 0},
    "physical_movements": {"const": 0},
    "physical_authority": {"const": false},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "bundle_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
