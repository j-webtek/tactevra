{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rocell.local/schemas/self_occlusion_projection_qualification_v1.schema.json",
  "title": "Synthetic self-occlusion projection qualification v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "scope", "domain_id", "camera_calibration_sha256",
    "camera_to_board_sha256", "robot_visual_mesh_sha256",
    "target_catalog_sha256", "uncertainty_profile_sha256",
    "projection_implementation_sha256", "clock_id", "feedback_source",
    "feedback_source_sha256", "clock_correlation_sha256",
    "interpolation_policy_id", "interpolation_policy_sha256",
    "maximum_feedback_bracket_gap_ns", "maximum_evidence_age_ns",
    "dilation_bound_px", "dilation_derivation_sha256",
    "charuco_reprojection_evidence_sha256",
    "feedback_resolution_noise_evidence_sha256",
    "backlash_repeatability_evidence_sha256", "visible_overlap_upper",
    "ambiguity_overlap_upper", "physical_deployment_qualified",
    "hardware_writes", "physical_movements", "limitations",
    "qualification_sha256"
  ],
  "properties": {
    "schema": {"const": "rocell.ai_self_occlusion_projection_qualification.v1"},
    "scope": {"const": "SYNTHETIC_OFFLINE_ONLY"},
    "domain_id": {"$ref": "#/$defs/identifier"},
    "camera_calibration_sha256": {"$ref": "#/$defs/sha256"},
    "camera_to_board_sha256": {"$ref": "#/$defs/sha256"},
    "robot_visual_mesh_sha256": {"$ref": "#/$defs/sha256"},
    "target_catalog_sha256": {"$ref": "#/$defs/sha256"},
    "uncertainty_profile_sha256": {"$ref": "#/$defs/sha256"},
    "projection_implementation_sha256": {"$ref": "#/$defs/sha256"},
    "clock_id": {"$ref": "#/$defs/identifier"},
    "feedback_source": {"const": "MEASURED_SERVO_POSITION"},
    "feedback_source_sha256": {"$ref": "#/$defs/sha256"},
    "clock_correlation_sha256": {"$ref": "#/$defs/sha256"},
    "interpolation_policy_id": {"const": "LINEAR_MEASURED_POSITION_BRACKET_V1"},
    "interpolation_policy_sha256": {"$ref": "#/$defs/sha256"},
    "maximum_feedback_bracket_gap_ns": {"type": "integer", "minimum": 1},
    "maximum_evidence_age_ns": {"type": "integer", "minimum": 1},
    "dilation_bound_px": {"type": "number", "minimum": 0, "maximum": 4096},
    "dilation_derivation_sha256": {"$ref": "#/$defs/sha256"},
    "charuco_reprojection_evidence_sha256": {"$ref": "#/$defs/sha256"},
    "feedback_resolution_noise_evidence_sha256": {"$ref": "#/$defs/sha256"},
    "backlash_repeatability_evidence_sha256": {"$ref": "#/$defs/sha256"},
    "visible_overlap_upper": {"const": 0.18},
    "ambiguity_overlap_upper": {"const": 0.22},
    "physical_deployment_qualified": {"const": false},
    "hardware_writes": {"const": 0},
    "physical_movements": {"const": 0},
    "limitations": {
      "type": "array", "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "qualification_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identifier": {
      "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    }
  }
}
