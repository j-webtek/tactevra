{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rocell.local/schemas/typing_joint_schedule_v1.schema.json",
  "title": "RoCell deterministic typing joint schedule v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "status", "source_trajectory_plan_sha256",
    "source_ik_screen_sha256", "profile", "profile_sha256",
    "time_scale_factor", "samples", "sample_count", "segments", "segment_count",
    "total_motion_and_dwell_time_ns", "peak_velocity_rad_s",
    "peak_acceleration_rad_s2", "peak_jerk_rad_s3",
    "minimum_velocity_margin_rad_s", "minimum_acceleration_margin_rad_s2",
    "minimum_jerk_margin_rad_s3", "limiting_joint", "limiting_constraint",
    "joint_dynamics_screening_executed",
    "joint_dynamics_all_samples_accepted", "installed_dynamics_qualified",
    "controller_tracking_qualified", "collision_screening_executed",
    "controller_commands", "hardware_commands_generated", "hardware_access",
    "physical_authority", "blockers", "schedule_sha256"
  ],
  "properties": {
    "schema": {"const": "rocell.typing_joint_schedule.v1"},
    "status": {"const": "READY_FOR_INSTALLED_GEOMETRY_AND_FRESH_STATE_SCREENING"},
    "source_trajectory_plan_sha256": {"$ref": "#/$defs/hash"},
    "source_ik_screen_sha256": {"$ref": "#/$defs/hash"},
    "profile": {"$ref": "#/$defs/profile"},
    "profile_sha256": {"$ref": "#/$defs/hash"},
    "time_scale_factor": {"type": "number", "exclusiveMinimum": 0, "maximum": 1000},
    "samples": {
      "type": "array", "minItems": 2, "maxItems": 4096,
      "items": {"$ref": "#/$defs/sample"}
    },
    "sample_count": {"type": "integer", "minimum": 2, "maximum": 4096},
    "segments": {
      "type": "array", "minItems": 1, "maxItems": 4095,
      "items": {"$ref": "#/$defs/segment"}
    },
    "segment_count": {"type": "integer", "minimum": 1, "maximum": 4095},
    "total_motion_and_dwell_time_ns": {"type": "integer", "minimum": 1},
    "peak_velocity_rad_s": {"$ref": "#/$defs/joints"},
    "peak_acceleration_rad_s2": {"$ref": "#/$defs/joints"},
    "peak_jerk_rad_s3": {"$ref": "#/$defs/joints"},
    "minimum_velocity_margin_rad_s": {"$ref": "#/$defs/joints"},
    "minimum_acceleration_margin_rad_s2": {"$ref": "#/$defs/joints"},
    "minimum_jerk_margin_rad_s3": {"$ref": "#/$defs/joints"},
    "limiting_joint": {"$ref": "#/$defs/joint_name"},
    "limiting_constraint": {"enum": ["VELOCITY", "ACCELERATION", "JERK"]},
    "joint_dynamics_screening_executed": {"const": true},
    "joint_dynamics_all_samples_accepted": {"const": true},
    "installed_dynamics_qualified": {"const": false},
    "controller_tracking_qualified": {"const": false},
    "collision_screening_executed": {"const": false},
    "controller_commands": {"type": "array", "maxItems": 0},
    "hardware_commands_generated": {"const": 0},
    "hardware_access": {"const": false},
    "physical_authority": {"const": false},
    "blockers": {
      "const": [
        "MEASURED_INSTALLED_DYNAMICS_REQUIRED",
        "INSTALLED_GEOMETRY_COLLISION_SCREENING_REQUIRED",
        "FRESH_OBSERVED_START_STATE_REQUIRED_FOR_EXECUTION"
      ]
    },
    "schedule_sha256": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "joint_name": {
      "enum": [
        "base_link_to_link1", "link1_to_link2", "link2_to_link3",
        "link3_to_link4", "link4_to_link5"
      ]
    },
    "joints": {
      "type": "object", "additionalProperties": false,
      "required": [
        "base_link_to_link1", "link1_to_link2", "link2_to_link3",
        "link3_to_link4", "link4_to_link5"
      ],
      "properties": {
        "base_link_to_link1": {"type": "number", "minimum": 0},
        "link1_to_link2": {"type": "number", "minimum": 0},
        "link2_to_link3": {"type": "number", "minimum": 0},
        "link3_to_link4": {"type": "number", "minimum": 0},
        "link4_to_link5": {"type": "number", "minimum": 0}
      }
    },
    "joint_positions": {
      "type": "object", "additionalProperties": false,
      "required": [
        "base_link_to_link1", "link1_to_link2", "link2_to_link3",
        "link3_to_link4", "link4_to_link5"
      ],
      "properties": {
        "base_link_to_link1": {"type": "number"},
        "link1_to_link2": {"type": "number"},
        "link2_to_link3": {"type": "number"},
        "link3_to_link4": {"type": "number"},
        "link4_to_link5": {"type": "number"}
      }
    },
    "profile": {
      "type": "object", "additionalProperties": false,
      "required": [
        "schema", "profile_id", "source_kind", "maximum_velocity_rad_s",
        "maximum_acceleration_rad_s2", "maximum_jerk_rad_s3",
        "maximum_time_scale_factor", "minimum_segment_duration_ns",
        "physical_tracking_qualification"
      ],
      "properties": {
        "schema": {"const": "rocell.typing_joint_dynamics_profile.v1"},
        "profile_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "source_kind": {"const": "SYNTHETIC_OFFLINE"},
        "maximum_velocity_rad_s": {"$ref": "#/$defs/joints"},
        "maximum_acceleration_rad_s2": {"$ref": "#/$defs/joints"},
        "maximum_jerk_rad_s3": {"$ref": "#/$defs/joints"},
        "maximum_time_scale_factor": {"type": "number", "exclusiveMinimum": 0, "maximum": 1000},
        "minimum_segment_duration_ns": {"type": "integer", "minimum": 1, "maximum": 1000000000},
        "physical_tracking_qualification": {"const": false}
      }
    },
    "sample": {
      "type": "object", "additionalProperties": false,
      "required": [
        "sequence", "endpoint_sequence", "phase", "action_index",
        "target_id", "phase_endpoint", "time_from_start_ns",
        "joint_positions_rad"
      ],
      "properties": {
        "sequence": {"type": "integer", "minimum": 0},
        "endpoint_sequence": {"type": "integer", "minimum": 0},
        "phase": {"type": "string", "minLength": 1},
        "action_index": {"oneOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
        "target_id": {"oneOf": [{"type": "string", "minLength": 1, "maxLength": 128}, {"type": "null"}]},
        "phase_endpoint": {"type": "boolean"},
        "time_from_start_ns": {"type": "integer", "minimum": 0},
        "joint_positions_rad": {"$ref": "#/$defs/joint_positions"}
      }
    },
    "segment": {
      "type": "object", "additionalProperties": false,
      "required": [
        "sequence", "source_sample_sequence", "destination_sample_sequence",
        "duration_ns", "destination_phase", "action_index", "target_id",
        "velocity_rad_s", "acceleration_rad_s2", "jerk_rad_s3",
        "velocity_margin_rad_s", "acceleration_margin_rad_s2",
        "jerk_margin_rad_s3", "limiting_joint", "limiting_constraint"
      ],
      "properties": {
        "sequence": {"type": "integer", "minimum": 0},
        "source_sample_sequence": {"type": "integer", "minimum": 0},
        "destination_sample_sequence": {"type": "integer", "minimum": 1},
        "duration_ns": {"type": "integer", "minimum": 1},
        "destination_phase": {"type": "string", "minLength": 1},
        "action_index": {"oneOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
        "target_id": {"oneOf": [{"type": "string", "minLength": 1, "maxLength": 128}, {"type": "null"}]},
        "velocity_rad_s": {"$ref": "#/$defs/joints"},
        "acceleration_rad_s2": {"$ref": "#/$defs/joints"},
        "jerk_rad_s3": {"$ref": "#/$defs/joints"},
        "velocity_margin_rad_s": {"$ref": "#/$defs/joints"},
        "acceleration_margin_rad_s2": {"$ref": "#/$defs/joints"},
        "jerk_margin_rad_s3": {"$ref": "#/$defs/joints"},
        "limiting_joint": {"$ref": "#/$defs/joint_name"},
        "limiting_constraint": {"enum": ["VELOCITY", "ACCELERATION", "JERK"]}
      }
    }
  }
}
