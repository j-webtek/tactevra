{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tactevra.local/schemas/residual_obstruction_v3_training_visual_review_v1.schema.json",
  "title": "Residual obstruction v3 training crop visual review",
  "type": "object",
  "required": ["schema", "scope", "source_commit", "source_report_sha256", "source_report_file_sha256", "prior_report_file_sha256", "contact_sheet_sha256", "reviewed_target", "reviewed_rows", "status", "findings", "limitations", "development_pixels_opened", "evaluation_opened", "hardware_writes", "physical_movements", "physical_authority", "review_sha256"],
  "properties": {
    "schema": {"const": "tactevra.ai_residual_obstruction_v3_training_visual_review.v1"},
    "scope": {"const": "TRAINING_ONLY_HUMAN_SIMULATED_REVIEW_NO_QUALIFICATION"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_report_sha256": {"$ref": "#/$defs/sha256"},
    "source_report_file_sha256": {"$ref": "#/$defs/sha256"},
    "prior_report_file_sha256": {"$ref": "#/$defs/sha256"},
    "contact_sheet_sha256": {"$ref": "#/$defs/sha256"},
    "reviewed_target": {"const": "keyboard:G"},
    "reviewed_rows": {"const": 24},
    "status": {"enum": ["PASS_WITH_LIMITATIONS", "FAIL"]},
    "findings": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "development_pixels_opened": {"const": false},
    "evaluation_opened": {"const": false},
    "hardware_writes": {"const": 0},
    "physical_movements": {"const": 0},
    "physical_authority": {"const": false},
    "review_sha256": {"$ref": "#/$defs/sha256"}
  },
  "additionalProperties": false,
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
