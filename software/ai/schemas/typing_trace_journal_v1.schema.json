{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tactevra.local/schemas/typing_trace_journal_v1.schema.json",
  "title": "RoCell typing trace journal v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "status", "correlation_id", "request_id", "action_count",
    "ordered_target_ids", "stages", "trace_tail_sha256",
    "controller_commands", "hardware_access", "physical_authority",
    "typing_trace_journal_sha256"
  ],
  "properties": {
    "schema": {"const": "rocell.typing_trace_journal.v1"},
    "status": {"const": "SEALED_ZERO_AUTHORITY_TRACE"},
    "correlation_id": {"$ref": "#/$defs/identifier"},
    "request_id": {"$ref": "#/$defs/identifier"},
    "action_count": {"type": "integer", "minimum": 1, "maximum": 64},
    "ordered_target_ids": {
      "type": "array", "minItems": 1, "maxItems": 64,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "stages": {
      "type": "array", "minItems": 14, "maxItems": 14,
      "items": {"$ref": "#/$defs/stage"}
    },
    "trace_tail_sha256": {"$ref": "#/$defs/sha256"},
    "controller_commands": {"const": []},
    "hardware_access": {"const": false},
    "physical_authority": {"const": false},
    "typing_trace_journal_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identifier": {
      "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "stage": {
      "type": "object", "additionalProperties": false,
      "required": [
        "ordinal", "stage", "artifact_bytes", "artifact_sha256",
        "previous_stage_sha256", "stage_sha256"
      ],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 0, "maximum": 13},
        "stage": {"enum": [
          "REQUEST", "AI_BATCH", "INGRESS", "EXECUTION_PLAN",
          "TRAJECTORY_PLAN", "IK_SCREEN", "JOINT_SCHEDULE",
          "COLLISION_SCREEN", "CONTROLLER_PREVIEW", "PERMIT_POLICY",
          "COMMAND_ENCODING", "DISPATCH_REHEARSAL", "FEEDBACK_REHEARSAL",
          "EFFECT_VERIFICATION_PLACEHOLDER"
        ]},
        "artifact_bytes": {
          "type": "integer", "minimum": 1, "maximum": 262144
        },
        "artifact_sha256": {"$ref": "#/$defs/sha256"},
        "previous_stage_sha256": {"$ref": "#/$defs/sha256"},
        "stage_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
