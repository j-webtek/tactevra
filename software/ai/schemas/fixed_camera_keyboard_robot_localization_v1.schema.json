{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tactevra.dev/schemas/fixed_camera_keyboard_robot_localization_v1.schema.json",
  "title": "Fixed-camera keyboard robot localization v1",
  "type": "object",
  "required": ["schema", "status", "measurement_sha256", "keyboard_package_sha256", "target_profile_sha256", "transform", "fit_residuals_mm", "holdout_residuals_mm", "board_to_robot_transform_verified", "profiles", "profile_separation_preserved", "motion_targets_emitted", "physical_clearance_verified", "motion_authorized", "contact_authorized", "limitations"],
  "properties": {
    "schema": {"const": "rocell.fixed_camera_keyboard_robot_localization.v1"},
    "status": {"enum": ["ROBOT_FRAME_LOCALIZATION_CANDIDATES_READY", "BOARD_TO_ROBOT_REGISTRATION_REJECTED"]},
    "measurement_sha256": {"$ref": "#/$defs/sha256"},
    "keyboard_package_sha256": {"$ref": "#/$defs/sha256"},
    "target_profile_sha256": {"$ref": "#/$defs/sha256"},
    "transform": {
      "type": "object",
      "required": ["source_frame", "target_frame", "rotation_matrix", "translation_mm", "fit_rms_residual_mm", "maximum_fit_residual_mm", "maximum_holdout_residual_mm"],
      "properties": {
        "source_frame": {"const": "RC03_board"}, "target_frame": {"const": "robot_base"},
        "rotation_matrix": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/vector3"}},
        "translation_mm": {"$ref": "#/$defs/vector3"},
        "fit_rms_residual_mm": {"type": "number", "minimum": 0},
        "maximum_fit_residual_mm": {"type": "number", "minimum": 0},
        "maximum_holdout_residual_mm": {"type": "number", "minimum": 0}
      }
    },
    "fit_residuals_mm": {"type": "object", "additionalProperties": {"type": "number", "minimum": 0}},
    "holdout_residuals_mm": {"type": "object", "additionalProperties": {"type": "number", "minimum": 0}},
    "board_to_robot_transform_verified": {"type": "boolean"},
    "profiles": {
      "type": "object", "required": ["no_attachment", "stylus_attachment"],
      "properties": {
        "no_attachment": {"$ref": "#/$defs/profile"},
        "stylus_attachment": {"$ref": "#/$defs/profile"}
      },
      "additionalProperties": false
    },
    "profile_separation_preserved": {"const": true},
    "motion_targets_emitted": {"const": false},
    "physical_clearance_verified": {"const": false},
    "motion_authorized": {"const": false},
    "contact_authorized": {"const": false},
    "limitations": {"type": "array", "minItems": 3, "items": {"type": "string"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "vector3": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
    "profile": {
      "type": "object",
      "required": ["profile", "board_to_robot_transform_verified", "robot_frame_localization_candidates_emitted", "robot_frame_localization_candidates", "motion_targets_emitted", "physical_clearance_verified", "motion_authorized", "contact_authorized", "blockers"],
      "properties": {
        "profile": {"enum": ["no_attachment", "stylus_attachment"]},
        "board_to_robot_transform_verified": {"type": "boolean"},
        "robot_frame_localization_candidates_emitted": {"type": "boolean"},
        "robot_frame_localization_candidates": {
          "type": "array",
          "items": {"type": "object", "required": ["key_id", "robot_xyz_mm"], "properties": {"key_id": {"type": "string"}, "robot_xyz_mm": {"$ref": "#/$defs/vector3"}}}
        },
        "motion_targets_emitted": {"const": false}, "physical_clearance_verified": {"const": false},
        "motion_authorized": {"const": false}, "contact_authorized": {"const": false},
        "blockers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["BOARD_TO_ROBOT_REGISTRATION_RESIDUAL_EXCEEDED", "PHYSICAL_CLEARANCE_UNVERIFIED", "STYLUS_TCP_UNVERIFIED", "STYLUS_TRAJECTORY_UNVERIFIED"]}}
      }
    }
  }
}
