{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tactevra.local/schemas/residual_obstruction_successor_fixture_v3.schema.json",
  "title": "Residual obstruction successor fixture v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "scope", "source", "base_scenes", "appearances", "variants", "split_policy", "render_admission", "training_plan", "development_gate", "images_generated", "training_started", "hardware_writes", "physical_movements", "physical_authority", "limitations", "bundle_sha256"],
  "properties": {
    "schema": {"const": "tactevra.ai_residual_obstruction_successor_fixture.v3"},
    "scope": {"const": "SYNTHETIC_ISAAC_PREDECLARATION_NO_QUALIFICATION"},
    "source": {"type": "object", "additionalProperties": false, "required": ["practice_manifest_file_sha256", "practice_corpus_sha256", "target_catalog_sha256", "diagnostic_file_sha256", "diagnostic_report_sha256", "rejected_model_sha256"], "properties": {"practice_manifest_file_sha256": {"$ref": "#/$defs/sha256"}, "practice_corpus_sha256": {"$ref": "#/$defs/sha256"}, "target_catalog_sha256": {"$ref": "#/$defs/sha256"}, "diagnostic_file_sha256": {"$ref": "#/$defs/sha256"}, "diagnostic_report_sha256": {"$ref": "#/$defs/sha256"}, "rejected_model_sha256": {"$ref": "#/$defs/sha256"}}},
    "base_scenes": {"type": "array", "minItems": 12, "maxItems": 12, "items": {"type": "object", "additionalProperties": false, "required": ["scene_id", "split", "isaac_seed", "fresh_render_required", "source_image_reuse_prohibited", "camera_pose_jitter_mm", "camera_rotation_jitter_deg", "fixture_surface_randomization"], "properties": {"scene_id": {"type": "string", "minLength": 1}, "split": {"enum": ["training", "development"]}, "isaac_seed": {"type": "integer", "minimum": 0}, "fresh_render_required": {"const": true}, "source_image_reuse_prohibited": {"const": true}, "camera_pose_jitter_mm": {"$ref": "#/$defs/vector3"}, "camera_rotation_jitter_deg": {"$ref": "#/$defs/vector3"}, "fixture_surface_randomization": {"const": "BOUNDED_PHYSICALLY_BASED"}}}},
    "appearances": {"type": "array", "minItems": 4, "items": {"type": "object", "additionalProperties": false, "required": ["appearance_id", "kind", "paired_across_variants"], "properties": {"appearance_id": {"type": "string", "minLength": 1}, "kind": {"enum": ["PHYSICALLY_BASED_LIGHTING", "PHYSICALLY_BASED_LIGHTING_AND_SENSOR"]}, "paired_across_variants": {"const": true}}}},
    "variants": {"type": "array", "minItems": 12, "items": {"type": "object", "additionalProperties": false, "required": ["variant_id", "decision", "family", "geometry"], "properties": {"variant_id": {"type": "string", "minLength": 1}, "decision": {"enum": ["VISIBLE", "ABSTAIN"]}, "family": {"type": "string", "minLength": 1}, "geometry": {"type": "object"}}}},
    "split_policy": {"type": "object", "additionalProperties": false, "required": ["base_scene_ids_disjoint", "minimum_independent_training_scenes", "minimum_independent_development_scenes", "training_observation_count", "development_observation_count", "evaluation_observation_count", "evaluation_group_present"], "properties": {"base_scene_ids_disjoint": {"const": true}, "minimum_independent_training_scenes": {"const": 8}, "minimum_independent_development_scenes": {"const": 4}, "training_observation_count": {"type": "integer", "minimum": 1}, "development_observation_count": {"type": "integer", "minimum": 1}, "evaluation_observation_count": {"const": 0}, "evaluation_group_present": {"const": false}}},
    "render_admission": {"type": "object", "required": ["renderer", "fresh_full_frame_required_per_base_scene", "source_image_warp_prohibited", "rgb_is_only_model_input", "truth_masks_retained_for_labels_only", "truth_masks_prohibited_as_model_input", "depth_retained_for_admission_only", "depth_prohibited_as_model_input", "physically_based_material_required", "mesh_geometry_required_for_physical_obstructions", "safe_region_overlap_must_match_declared_range", "fail_on_duplicate_observation_bytes"], "properties": {"renderer": {"const": "ISAAC_SIM_3D"}, "fresh_full_frame_required_per_base_scene": {"const": true}, "source_image_warp_prohibited": {"const": true}, "rgb_is_only_model_input": {"const": true}, "truth_masks_retained_for_labels_only": {"const": true}, "truth_masks_prohibited_as_model_input": {"const": true}, "depth_retained_for_admission_only": {"const": true}, "depth_prohibited_as_model_input": {"const": true}, "physically_based_material_required": {"const": true}, "mesh_geometry_required_for_physical_obstructions": {"const": true}, "safe_region_overlap_must_match_declared_range": {"const": true}, "fail_on_duplicate_observation_bytes": {"const": true}}, "additionalProperties": false},
    "training_plan": {"type": "object"},
    "development_gate": {"type": "object", "required": ["missed_obstruction_rate_upper", "visible_false_stop_rate_upper", "confidence_level", "base_scene_cluster_bootstrap_resamples", "base_scene_cluster_bootstrap_seed", "worst_appearance_must_pass", "worst_variant_family_must_pass", "minimum_target_local_separation_margin", "every_target_margin_must_be_strictly_positive", "point_and_cluster_upper_bounds_must_pass", "evaluation_must_remain_unopened"], "properties": {"missed_obstruction_rate_upper": {"const": 0.02}, "visible_false_stop_rate_upper": {"const": 0.06}, "confidence_level": {"const": 0.95}, "base_scene_cluster_bootstrap_resamples": {"type": "integer", "minimum": 1000}, "base_scene_cluster_bootstrap_seed": {"type": "integer"}, "worst_appearance_must_pass": {"const": true}, "worst_variant_family_must_pass": {"const": true}, "minimum_target_local_separation_margin": {"const": 0.0}, "every_target_margin_must_be_strictly_positive": {"const": true}, "point_and_cluster_upper_bounds_must_pass": {"const": true}, "evaluation_must_remain_unopened": {"const": true}}, "additionalProperties": false},
    "images_generated": {"const": false},
    "training_started": {"const": false},
    "hardware_writes": {"const": 0},
    "physical_movements": {"const": 0},
    "physical_authority": {"const": false},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "bundle_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "vector3": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}}
  }
}
