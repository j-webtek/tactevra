{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tactevra.local/schemas/offline_intent_classification_v1.schema.json",
  "title": "Internal offline intent classification v1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "intent_type", "device"],
      "properties": {
        "schema": {"const": "rocell.offline_intent_classification.v1"},
        "intent_type": {"const": "TYPE_TEXT"},
        "device": {"enum": ["KEYBOARD", "PHONE"]}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "intent_type", "question"],
      "properties": {
        "schema": {"const": "rocell.offline_intent_classification.v1"},
        "intent_type": {"const": "CLARIFY"},
        "question": {"enum": ["device_ambiguous", "text_ambiguous", "intent_ambiguous"]}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "intent_type", "reason"],
      "properties": {
        "schema": {"const": "rocell.offline_intent_classification.v1"},
        "intent_type": {"const": "REFUSE"},
        "reason": {"enum": ["operation_not_available", "unsupported_by_profile", "stale_observation", "phone_state_unverified"]}
      }
    }
  ]
}
