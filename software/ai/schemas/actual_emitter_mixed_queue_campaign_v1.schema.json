{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tactevra.local/schemas/actual_emitter_mixed_queue_campaign_v1.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "campaign_id", "evidence_class", "environment", "actual_shared_emitter_used", "fixture_scope", "patterns", "round_count", "rounds", "request_order_preserved", "warm_p50_improved_observed", "warm_p95_improved_observed", "timing_used_for_admission", "complete_solve_fallback_required", "automatic_retry_allowed", "executor_attached", "controller_opened", "transport_opened", "controller_commands", "hardware_writes", "physical_movements", "physical_authority", "campaign_sha256"],
  "properties": {
    "schema": {"const": "rocell.actual_emitter_mixed_queue_campaign.v1"}, "campaign_id": {"type": "string", "minLength": 1}, "evidence_class": {"const": "HOST_MEASURED_SYNTHETIC_INTEGRATION"}, "environment": {"type": "object"}, "actual_shared_emitter_used": {"const": true}, "fixture_scope": {"const": "SYNTHETIC_INTEGRATION_ONLY"},
    "patterns": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"type": "object", "additionalProperties": false, "required": ["pattern_id", "target_ids"], "properties": {"pattern_id": {"type": "string", "minLength": 1}, "target_ids": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}}}}}, "round_count": {"const": 2},
    "rounds": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "object", "additionalProperties": false, "required": ["round", "request_ids", "payload_sha256", "receipt_statuses", "duration_ns", "p50_duration_ns", "p95_duration_ns", "cache_delta"], "properties": {"round": {"enum": ["COLD", "WARM"]}, "request_ids": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"type": "string", "minLength": 1}}, "payload_sha256": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"$ref": "#/$defs/hash"}}, "receipt_statuses": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"const": "SHADOW_COMPLETED"}}, "duration_ns": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"type": "integer", "minimum": 0}}, "p50_duration_ns": {"type": "integer", "minimum": 0}, "p95_duration_ns": {"type": "integer", "minimum": 0}, "cache_delta": {"$ref": "#/$defs/counters"}}}},
    "request_order_preserved": {"const": true}, "warm_p50_improved_observed": {"type": "boolean"}, "warm_p95_improved_observed": {"type": "boolean"}, "timing_used_for_admission": {"const": false}, "complete_solve_fallback_required": {"const": true}, "automatic_retry_allowed": {"const": false}, "executor_attached": {"const": false}, "controller_opened": {"const": false}, "transport_opened": {"const": false}, "controller_commands": {"const": []}, "hardware_writes": {"const": 0}, "physical_movements": {"const": 0}, "physical_authority": {"const": false}, "campaign_sha256": {"$ref": "#/$defs/hash"}
  }, "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "counters": {"type": "object", "additionalProperties": false, "required": ["lookups", "hits", "misses", "stores", "capacity_skips"], "properties": {"lookups": {"type": "integer", "minimum": 0}, "hits": {"type": "integer", "minimum": 0}, "misses": {"type": "integer", "minimum": 0}, "stores": {"type": "integer", "minimum": 0}, "capacity_skips": {"type": "integer", "minimum": 0}}}}
}
