{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rocell.local/schemas/c03_cable_envelope_manifest_v1.schema.json",
  "title": "C03 cable envelope manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "cable_manifest_id", "captured_at_utc", "valid_until_utc",
    "c03_installed_collision_qualification_sha256",
    "c03_rigid_attachment_binding_report_sha256",
    "partitioned_typing_collision_intake_sha256", "collision_contract_sha256",
    "installed_collision_profile_content_sha256", "installed_collision_profile_file_sha256",
    "measurement_manifest_file_sha256", "measurement_manifest_content_sha256",
    "root_frame", "sources", "samples", "sweeps", "content_sha256"
  ],
  "properties": {
    "schema": {"const": "tactevra.c03_cable_envelope_manifest.v1"},
    "cable_manifest_id": {"type": "string", "minLength": 1},
    "captured_at_utc": {"$ref": "#/$defs/utc"},
    "valid_until_utc": {"$ref": "#/$defs/utc"},
    "c03_installed_collision_qualification_sha256": {"$ref": "#/$defs/sha256"},
    "c03_rigid_attachment_binding_report_sha256": {"$ref": "#/$defs/sha256"},
    "partitioned_typing_collision_intake_sha256": {"$ref": "#/$defs/sha256"},
    "collision_contract_sha256": {"$ref": "#/$defs/sha256"},
    "installed_collision_profile_content_sha256": {"$ref": "#/$defs/sha256"},
    "installed_collision_profile_file_sha256": {"$ref": "#/$defs/sha256"},
    "measurement_manifest_file_sha256": {"$ref": "#/$defs/sha256"},
    "measurement_manifest_content_sha256": {"$ref": "#/$defs/sha256"},
    "root_frame": {"type": "string", "minLength": 1},
    "sources": {
      "type": "array", "minItems": 1, "maxItems": 128,
      "items": {"$ref": "#/$defs/source"}
    },
    "samples": {
      "type": "array", "minItems": 2, "maxItems": 4096,
      "items": {"$ref": "#/$defs/sample"}
    },
    "sweeps": {
      "type": "array", "minItems": 1, "maxItems": 4096,
      "items": {"$ref": "#/$defs/sweep"}
    },
    "content_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "utc": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["source_id", "sha256", "captured_at_utc", "method", "notes"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "captured_at_utc": {"$ref": "#/$defs/utc"},
        "method": {"type": "string", "minLength": 1},
        "notes": {"type": "string"}
      }
    },
    "capsule": {
      "type": "object", "additionalProperties": false,
      "required": [
        "start_mm", "end_mm", "measured_radius_mm", "capture_uncertainty_mm",
        "unobserved_deformation_mm"
      ],
      "properties": {
        "start_mm": {"$ref": "#/$defs/vec3"},
        "end_mm": {"$ref": "#/$defs/vec3"},
        "measured_radius_mm": {"type": "number", "exclusiveMinimum": 0},
        "capture_uncertainty_mm": {"type": "number", "minimum": 0},
        "unobserved_deformation_mm": {"type": "number", "minimum": 0}
      }
    },
    "vec3": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {"type": "number"}
    },
    "body": {
      "type": "object", "additionalProperties": false,
      "required": ["body_id", "source_id", "capsules"],
      "properties": {
        "body_id": {"type": "string", "minLength": 1},
        "source_id": {"type": "string", "minLength": 1},
        "capsules": {
          "type": "array", "minItems": 1, "maxItems": 64,
          "items": {"$ref": "#/$defs/capsule"}
        }
      }
    },
    "sample": {
      "type": "object", "additionalProperties": false,
      "required": [
        "partition_index", "sample_sequence", "sample_plan_sha256",
        "captured_at_utc", "method", "bodies"
      ],
      "properties": {
        "partition_index": {"type": "integer", "minimum": 0},
        "sample_sequence": {"type": "integer", "minimum": 0},
        "sample_plan_sha256": {"$ref": "#/$defs/sha256"},
        "captured_at_utc": {"$ref": "#/$defs/utc"},
        "method": {"const": "DIRECT_CAPTURED_CAPSULE_CHAIN"},
        "bodies": {
          "type": "array", "minItems": 1, "maxItems": 128,
          "items": {"$ref": "#/$defs/body"}
        }
      }
    },
    "sweep": {
      "type": "object", "additionalProperties": false,
      "required": [
        "partition_index", "segment_sequence", "owned_segment_sequence",
        "start_sample_sha256", "end_sample_sha256", "captured_at_utc",
        "construction_method", "intermediate_observation_count", "bodies"
      ],
      "properties": {
        "partition_index": {"type": "integer", "minimum": 0},
        "segment_sequence": {"type": "integer", "minimum": 0},
        "owned_segment_sequence": {"type": "integer", "minimum": 0},
        "start_sample_sha256": {"$ref": "#/$defs/sha256"},
        "end_sample_sha256": {"$ref": "#/$defs/sha256"},
        "captured_at_utc": {"$ref": "#/$defs/utc"},
        "construction_method": {
          "enum": [
            "DIRECT_CAPTURED_CONSERVATIVE_ENVELOPE",
            "MULTI_POSE_CAPTURE_UNION_WITH_VALIDATED_BOUND"
          ]
        },
        "intermediate_observation_count": {"type": "integer", "minimum": 1},
        "bodies": {
          "type": "array", "minItems": 1, "maxItems": 128,
          "items": {"$ref": "#/$defs/body"}
        }
      }
    }
  }
}
