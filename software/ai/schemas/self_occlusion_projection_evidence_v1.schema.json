{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rocell.local/schemas/self_occlusion_projection_evidence_v1.schema.json",
  "title": "Read-only synthetic self-occlusion projection evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "scope", "projection_id", "domain_id", "frame",
    "feedback_bracket", "projection_bindings", "dilation", "target_results",
    "hardware_writes", "physical_movements", "physical_authority",
    "limitations", "evidence_sha256"
  ],
  "properties": {
    "schema": {"const": "rocell.ai_self_occlusion_projection_evidence.v1"},
    "scope": {"const": "SYNTHETIC_OFFLINE_ONLY"},
    "projection_id": {"$ref": "#/$defs/identifier"},
    "domain_id": {"$ref": "#/$defs/identifier"},
    "frame": {
      "type": "object", "additionalProperties": false,
      "required": [
        "frame_id", "image_sha256", "exposure_timestamp_ns",
        "exposure_start_ns", "exposure_end_ns", "clock_id"
      ],
      "properties": {
        "frame_id": {"$ref": "#/$defs/identifier"},
        "image_sha256": {"$ref": "#/$defs/sha256"},
        "exposure_timestamp_ns": {"type": "integer", "minimum": 1},
        "exposure_start_ns": {"type": "integer", "minimum": 1},
        "exposure_end_ns": {"type": "integer", "minimum": 1},
        "clock_id": {"$ref": "#/$defs/identifier"}
      }
    },
    "feedback_bracket": {
      "type": "object", "additionalProperties": false,
      "required": [
        "source", "feedback_source_sha256", "pre_sample_sha256", "pre_timestamp_ns",
        "post_sample_sha256", "post_timestamp_ns", "clock_id",
        "clock_correlation_sha256", "interpolation_policy_id",
        "interpolation_policy_sha256", "interpolated_measured_state_sha256"
      ],
      "properties": {
        "source": {"const": "MEASURED_SERVO_POSITION"},
        "feedback_source_sha256": {"$ref": "#/$defs/sha256"},
        "pre_sample_sha256": {"$ref": "#/$defs/sha256"},
        "pre_timestamp_ns": {"type": "integer", "minimum": 1},
        "post_sample_sha256": {"$ref": "#/$defs/sha256"},
        "post_timestamp_ns": {"type": "integer", "minimum": 1},
        "clock_id": {"$ref": "#/$defs/identifier"},
        "clock_correlation_sha256": {"$ref": "#/$defs/sha256"},
        "interpolation_policy_id": {"const": "LINEAR_MEASURED_POSITION_BRACKET_V1"},
        "interpolation_policy_sha256": {"$ref": "#/$defs/sha256"},
        "interpolated_measured_state_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "projection_bindings": {
      "type": "object", "additionalProperties": false,
      "required": [
        "qualification_sha256", "camera_calibration_sha256",
        "camera_to_board_sha256", "robot_visual_mesh_sha256",
        "target_catalog_sha256", "uncertainty_profile_sha256",
        "projection_implementation_sha256"
      ],
      "properties": {
        "qualification_sha256": {"$ref": "#/$defs/sha256"},
        "camera_calibration_sha256": {"$ref": "#/$defs/sha256"},
        "camera_to_board_sha256": {"$ref": "#/$defs/sha256"},
        "robot_visual_mesh_sha256": {"$ref": "#/$defs/sha256"},
        "target_catalog_sha256": {"$ref": "#/$defs/sha256"},
        "uncertainty_profile_sha256": {"$ref": "#/$defs/sha256"},
        "projection_implementation_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "dilation": {
      "type": "object", "additionalProperties": false,
      "required": ["bound_px", "derivation_sha256"],
      "properties": {
        "bound_px": {"type": "number", "minimum": 0, "maximum": 4096},
        "derivation_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "target_results": {
      "type": "array", "minItems": 1, "maxItems": 256,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": [
          "target_id", "center_covered", "safe_region_overlap_fraction",
          "dilated_safe_region_overlap_fraction", "decision"
        ],
        "properties": {
          "target_id": {"$ref": "#/$defs/identifier"},
          "center_covered": {"type": "boolean"},
          "safe_region_overlap_fraction": {"type": "number", "minimum": 0, "maximum": 1},
          "dilated_safe_region_overlap_fraction": {"type": "number", "minimum": 0, "maximum": 1},
          "decision": {
            "enum": ["VISIBLE", "ABSTAIN_AMBIGUOUS", "ABSTAIN_SELF_OCCLUDED"]
          }
        }
      }
    },
    "hardware_writes": {"const": 0},
    "physical_movements": {"const": 0},
    "physical_authority": {"const": false},
    "limitations": {
      "type": "array", "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "evidence_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identifier": {
      "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    }
  }
}
