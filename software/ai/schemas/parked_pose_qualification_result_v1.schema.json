{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tactevra.local/schemas/parked_pose_qualification_result_v1.schema.json",
  "title": "Parked pose observation qualification result v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "scope", "status", "campaign_sha256", "criteria", "synthetic", "physical", "incomplete_reasons", "physical_deployment_qualified", "controller_authority", "hardware_writes", "physical_movements", "collection_effects", "limitations", "result_sha256"],
  "properties": {
    "schema": {"const": "rocell.ai_parked_pose_qualification_result.v1"},
    "scope": {"const": "SUPERVISED_PARKED_OBSERVATION_EVIDENCE_ONLY"},
    "status": {"enum": ["INCOMPLETE", "EVIDENCE_COMPLETE_FOR_OWNER_REVIEW"]},
    "campaign_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "criteria": {"type": "object", "additionalProperties": {"type": "boolean"}},
    "synthetic": {"$ref": "#/$defs/score"},
    "physical": {"$ref": "#/$defs/physicalScore"},
    "incomplete_reasons": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "physical_deployment_qualified": {"const": false}, "controller_authority": {"const": false},
    "hardware_writes": {"const": 0}, "physical_movements": {"const": 0},
    "collection_effects": {
      "type": "object", "additionalProperties": false,
      "required": ["hardware_write_count", "physical_movement_count", "authorization_evidence_sha256"],
      "properties": {
        "hardware_write_count": {"type": "integer", "minimum": 0}, "physical_movement_count": {"type": "integer", "minimum": 0},
        "authorization_evidence_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
      }
    },
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "result_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "interval": {
      "type": "object", "additionalProperties": false,
      "required": ["events", "trials", "rate", "lower_95", "upper_95"],
      "properties": {
        "events": {"type": "integer", "minimum": 0}, "trials": {"type": "integer", "minimum": 0},
        "rate": {"type": "number", "minimum": 0, "maximum": 1}, "lower_95": {"type": "number", "minimum": 0, "maximum": 1},
        "upper_95": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "score": {
      "type": "object", "additionalProperties": false,
      "required": ["observation_count", "visible_count", "known_self_occlusion_count", "residual_obstruction_count", "false_stops", "accepted_known_self_occlusion_count", "accepted_residual_obstruction_count", "geometric_path_missed_known_self_occlusion_count", "residual_path_missed_obstruction_count", "accepted_known_self_occlusion_ids", "accepted_residual_obstruction_ids"],
      "properties": {
        "observation_count": {"type": "integer", "minimum": 0}, "visible_count": {"type": "integer", "minimum": 0},
        "known_self_occlusion_count": {"type": "integer", "minimum": 0}, "residual_obstruction_count": {"type": "integer", "minimum": 0},
        "false_stops": {"$ref": "#/$defs/interval"},
        "accepted_known_self_occlusion_count": {"type": "integer", "minimum": 0}, "accepted_residual_obstruction_count": {"type": "integer", "minimum": 0},
        "geometric_path_missed_known_self_occlusion_count": {"type": "integer", "minimum": 0},
        "residual_path_missed_obstruction_count": {"type": "integer", "minimum": 0},
        "accepted_known_self_occlusion_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "accepted_residual_obstruction_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "physicalScore": {
      "type": "object", "additionalProperties": false,
      "required": ["observation_count", "visible_count", "known_self_occlusion_count", "residual_obstruction_count", "false_stops", "accepted_known_self_occlusion_count", "accepted_residual_obstruction_count", "geometric_path_missed_known_self_occlusion_count", "residual_path_missed_obstruction_count", "accepted_known_self_occlusion_ids", "accepted_residual_obstruction_ids", "completed_cycle_count", "session_count", "maximum_park_repeatability_mm", "maximum_charuco_drift_mm"],
      "properties": {
        "observation_count": {"type": "integer", "minimum": 0}, "visible_count": {"type": "integer", "minimum": 0},
        "known_self_occlusion_count": {"type": "integer", "minimum": 0}, "residual_obstruction_count": {"type": "integer", "minimum": 0},
        "false_stops": {"$ref": "#/$defs/interval"},
        "accepted_known_self_occlusion_count": {"type": "integer", "minimum": 0}, "accepted_residual_obstruction_count": {"type": "integer", "minimum": 0},
        "geometric_path_missed_known_self_occlusion_count": {"type": "integer", "minimum": 0}, "residual_path_missed_obstruction_count": {"type": "integer", "minimum": 0},
        "accepted_known_self_occlusion_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "accepted_residual_obstruction_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "completed_cycle_count": {"type": "integer", "minimum": 0}, "session_count": {"type": "integer", "minimum": 0},
        "maximum_park_repeatability_mm": {"type": ["number", "null"], "minimum": 0},
        "maximum_charuco_drift_mm": {"type": ["number", "null"], "minimum": 0}
      }
    }
  }
}
