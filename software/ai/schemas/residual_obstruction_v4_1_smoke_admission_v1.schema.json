{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tactevra.local/schemas/residual_obstruction_v4_1_smoke_admission_v1.schema.json",
  "title": "Residual obstruction v4.1 smoke admission",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "status", "scope", "manifest_file_sha256", "dataset_sha256",
    "fixture_bundle_sha256", "observation_count", "reference_count",
    "unique_observation_rgb_count", "target_ids", "evaluation_observation_count",
    "pooled_auc", "per_target_auc", "normalization_decision", "normalization_finding",
    "hardware_writes", "physical_movements", "physical_authority", "limitations",
    "report_sha256"
  ],
  "properties": {
    "schema": {"const": "tactevra.ai_residual_obstruction_v4_1_smoke_admission.v1"},
    "status": {"const": "PASS_WITH_LIMITATIONS"},
    "scope": {"const": "SYNTHETIC_ISAAC_REFERENCE_PAIR_SMOKE_NO_QUALIFICATION"},
    "manifest_file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "dataset_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fixture_bundle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "observation_count": {"type": "integer", "minimum": 1},
    "reference_count": {"type": "integer", "minimum": 1},
    "unique_observation_rgb_count": {"type": "integer", "minimum": 1},
    "target_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "evaluation_observation_count": {"const": 0},
    "pooled_auc": {"$ref": "#/$defs/metricMap"},
    "per_target_auc": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/metricMap"}},
    "normalization_decision": {"const": "RETAIN_SELF_AND_REFERENCE_CONTEXT_FOR_DEVELOPMENT_COMPARISON"},
    "normalization_finding": {"type": "string", "minLength": 1},
    "hardware_writes": {"const": 0},
    "physical_movements": {"const": 0},
    "physical_authority": {"const": false},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "metricMap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_mean_absolute_difference",
        "self_crop_normalized_mean_absolute_difference",
        "context_normalized_mean_absolute_difference"
      ],
      "properties": {
        "raw_mean_absolute_difference": {"type": "number", "minimum": 0, "maximum": 1},
        "self_crop_normalized_mean_absolute_difference": {"type": "number", "minimum": 0, "maximum": 1},
        "context_normalized_mean_absolute_difference": {"type": "number", "minimum": 0, "maximum": 1}
      }
    }
  }
}
