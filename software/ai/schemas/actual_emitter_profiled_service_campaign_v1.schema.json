{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tactevra.local/schemas/actual_emitter_profiled_service_campaign_v1.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "campaign_id", "evidence_class", "environment", "actual_shared_emitter_used", "fixture_scope", "ordered_targets", "case_count", "cases", "timing_used_for_admission", "complete_solve_fallback_required", "automatic_retry_allowed", "executor_attached", "controller_opened", "transport_opened", "controller_commands", "hardware_writes", "physical_movements", "physical_authority", "campaign_sha256"],
  "properties": {
    "schema": {"const": "rocell.actual_emitter_profiled_service_campaign.v1"}, "campaign_id": {"type": "string", "minLength": 1}, "evidence_class": {"const": "HOST_MEASURED_SYNTHETIC_INTEGRATION"}, "environment": {"type": "object"}, "actual_shared_emitter_used": {"const": true}, "fixture_scope": {"const": "SYNTHETIC_INTEGRATION_ONLY"}, "ordered_targets": {"const": ["R", "O", "B", "O", "T"]}, "case_count": {"const": 7},
    "cases": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"type": "object", "additionalProperties": false, "required": ["case", "status", "profile_decision", "duration_ns", "payload_sha256", "cache_delta"], "properties": {"case": {"enum": ["QUALIFIED_COLD", "QUALIFIED_WARM", "CALIBRATION_FALLBACK", "EVIDENCE_FALLBACK", "CANCEL_BEFORE_ADMISSION", "RELOAD_FALLBACK", "RESTART_FALLBACK"]}, "status": {"enum": ["SHADOW_COMPLETED", "CANCELED_BEFORE_ADMISSION"]}, "profile_decision": {"enum": ["EXACT_INPUT_REUSE_SHADOW_ELIGIBLE", "FULL_SOLVE_ONLY"]}, "duration_ns": {"type": "integer", "minimum": 0}, "payload_sha256": {"$ref": "#/$defs/hash"}, "cache_delta": {"$ref": "#/$defs/counters"}}}},
    "timing_used_for_admission": {"const": false}, "complete_solve_fallback_required": {"const": true}, "automatic_retry_allowed": {"const": false}, "executor_attached": {"const": false}, "controller_opened": {"const": false}, "transport_opened": {"const": false}, "controller_commands": {"const": []}, "hardware_writes": {"const": 0}, "physical_movements": {"const": 0}, "physical_authority": {"const": false}, "campaign_sha256": {"$ref": "#/$defs/hash"}
  }, "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "counters": {"type": "object", "additionalProperties": false, "required": ["lookups", "hits", "misses", "stores", "capacity_skips"], "properties": {"lookups": {"type": "integer", "minimum": 0}, "hits": {"type": "integer", "minimum": 0}, "misses": {"type": "integer", "minimum": 0}, "stores": {"type": "integer", "minimum": 0}, "capacity_skips": {"type": "integer", "minimum": 0}}}}
}
