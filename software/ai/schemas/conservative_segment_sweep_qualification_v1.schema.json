{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rocell.local/schemas/conservative_segment_sweep_qualification_v1.schema.json",
  "title": "RoCell conservative segment sweep qualification v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "status", "trajectory_screening_sha256",
    "bounded_segment_qualification_sha256",
    "installed_collision_profile_sha256", "kinematic_model_sha256",
    "segment_count", "segment_reports", "rigid_bound_method",
    "configuration_bound_method", "clearance_lower_bound_method",
    "minimum_clearance_lower_bound_mm", "limiting_segment_sequence",
    "limiting_body_pair", "all_segment_clearance_bounds_determinate",
    "all_conservative_segment_sweeps_clear",
    "all_pair_exclusions_physically_accepted",
    "continuous_collision_proven_for_bound_geometry", "blockers",
    "next_required_stage", "controller_commands", "hardware_commands_generated",
    "hardware_access", "physical_authority",
    "conservative_sweep_qualification_sha256"
  ],
  "properties": {
    "schema": {"const": "rocell.conservative_segment_sweep_qualification.v1"},
    "status": {"enum": [
      "CONSERVATIVE_SEGMENT_SWEEPS_CLEAR_RELEASE_GATES_REMAIN",
      "BLOCKED_CONSERVATIVE_SWEEP_COLLISION",
      "BLOCKED_INCOMPLETE_CONSERVATIVE_SWEEP_EVIDENCE"
    ]},
    "trajectory_screening_sha256": {"$ref": "#/$defs/hash"},
    "bounded_segment_qualification_sha256": {"$ref": "#/$defs/hash"},
    "installed_collision_profile_sha256": {"$ref": "#/$defs/hash"},
    "kinematic_model_sha256": {"$ref": "#/$defs/hash"},
    "segment_count": {"type": "integer", "minimum": 1, "maximum": 255},
    "segment_reports": {
      "type": "array", "minItems": 1, "maxItems": 255,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": [
          "segment_sequence", "start_sample_sha256", "end_sample_sha256",
          "joint_delta_rad", "rigid_motion_bound_mm_by_body",
          "configuration_envelope_sha256_by_body",
          "conservative_contract_sha256", "collision_report_sha256",
          "clearance_lower_bound_report_sha256", "clearance_lower_bound_status",
          "minimum_clearance_lower_bound_mm", "clearance_limiting_body_pair", "status",
          "collision_free_diagnostic", "collisions", "pose_blockers"
        ],
        "properties": {
          "segment_sequence": {"type": "integer", "minimum": 0},
          "start_sample_sha256": {"$ref": "#/$defs/hash"},
          "end_sample_sha256": {"$ref": "#/$defs/hash"},
          "joint_delta_rad": {"$ref": "#/$defs/jointMap"},
          "rigid_motion_bound_mm_by_body": {
            "type": "object", "additionalProperties": {"type": "number", "minimum": 0}
          },
          "configuration_envelope_sha256_by_body": {
            "type": "object", "additionalProperties": {"$ref": "#/$defs/hash"}
          },
          "conservative_contract_sha256": {"$ref": "#/$defs/hash"},
          "collision_report_sha256": {"$ref": "#/$defs/hash"},
          "clearance_lower_bound_report_sha256": {"$ref": "#/$defs/hash"},
          "clearance_lower_bound_status": {
            "enum": ["CLEAR", "COLLISION", "INDETERMINATE"]
          },
          "minimum_clearance_lower_bound_mm": {
            "type": ["number", "null"], "minimum": 0
          },
          "clearance_limiting_body_pair": {
            "oneOf": [
              {"type": "null"},
              {
                "type": "array", "minItems": 2, "maxItems": 2,
                "items": {"type": "string", "minLength": 1}
              }
            ]
          },
          "status": {"type": "string", "minLength": 1},
          "collision_free_diagnostic": {"type": "boolean"},
          "collisions": {"type": "array"},
          "pose_blockers": {"type": "array"}
        }
      }
    },
    "rigid_bound_method": {"type": "string", "minLength": 1},
    "configuration_bound_method": {"type": "string", "minLength": 1},
    "clearance_lower_bound_method": {"type": "string", "minLength": 1},
    "minimum_clearance_lower_bound_mm": {
      "type": ["number", "null"], "minimum": 0
    },
    "limiting_segment_sequence": {
      "type": ["integer", "null"], "minimum": 0
    },
    "limiting_body_pair": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "array", "minItems": 2, "maxItems": 2,
          "items": {"type": "string", "minLength": 1}
        }
      ]
    },
    "all_segment_clearance_bounds_determinate": {"type": "boolean"},
    "all_conservative_segment_sweeps_clear": {"type": "boolean"},
    "all_pair_exclusions_physically_accepted": {"type": "boolean"},
    "continuous_collision_proven_for_bound_geometry": {"type": "boolean"},
    "blockers": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "next_required_stage": {"type": "string", "minLength": 1},
    "controller_commands": {"type": "array", "maxItems": 0},
    "hardware_commands_generated": {"const": 0},
    "hardware_access": {"const": false},
    "physical_authority": {"const": false},
    "conservative_sweep_qualification_sha256": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "jointMap": {
      "type": "object", "additionalProperties": false,
      "required": [
        "base_link_to_link1", "link1_to_link2", "link2_to_link3",
        "link3_to_link4", "link4_to_link5"
      ],
      "properties": {
        "base_link_to_link1": {"type": "number", "minimum": 0},
        "link1_to_link2": {"type": "number", "minimum": 0},
        "link2_to_link3": {"type": "number", "minimum": 0},
        "link3_to_link4": {"type": "number", "minimum": 0},
        "link4_to_link5": {"type": "number", "minimum": 0}
      }
    }
  }
}
