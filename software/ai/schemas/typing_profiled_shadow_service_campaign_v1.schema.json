{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tactevra.local/schemas/typing_profiled_shadow_service_campaign_v1.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "campaign_id", "evidence_class", "environment", "case_count", "cases", "reference_receipts_equivalent", "complete_solve_fallback_required", "automatic_retry_allowed", "executor_attached", "controller_opened", "transport_opened", "controller_commands", "hardware_writes", "physical_movements", "physical_authority", "campaign_sha256"],
  "properties": {
    "schema": {"const": "rocell.typing_profiled_shadow_service_campaign.v1"}, "campaign_id": {"type": "string", "minLength": 1}, "evidence_class": {"const": "HOST_MEASURED_OFFLINE"}, "environment": {"type": "object"}, "case_count": {"const": 5},
    "cases": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"type": "object", "additionalProperties": false, "required": ["case", "status", "profile_decision", "exact_reuse_enabled", "cache_counters"], "properties": {"case": {"enum": ["QUALIFIED_CACHE_PATH", "CALIBRATION_FULL_SOLVE_PATH", "EVIDENCE_FULL_SOLVE_PATH", "RELOAD_RETIRES_PROFILE", "RESTART_RETIRES_PROFILE"]}, "status": {"const": "SHADOW_COMPLETED"}, "profile_decision": {"enum": ["EXACT_INPUT_REUSE_SHADOW_ELIGIBLE", "FULL_SOLVE_ONLY"]}, "exact_reuse_enabled": {"type": "boolean"}, "cache_counters": {"$ref": "#/$defs/counters"}}}},
    "reference_receipts_equivalent": {"const": true}, "complete_solve_fallback_required": {"const": true}, "automatic_retry_allowed": {"const": false}, "executor_attached": {"const": false}, "controller_opened": {"const": false}, "transport_opened": {"const": false}, "controller_commands": {"const": []}, "hardware_writes": {"const": 0}, "physical_movements": {"const": 0}, "physical_authority": {"const": false}, "campaign_sha256": {"$ref": "#/$defs/hash"}
  }, "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "counters": {"type": "object", "additionalProperties": false, "required": ["lookups", "hits", "misses", "stores", "capacity_skips"], "properties": {"lookups": {"type": "integer", "minimum": 0}, "hits": {"type": "integer", "minimum": 0}, "misses": {"type": "integer", "minimum": 0}, "stores": {"type": "integer", "minimum": 0}, "capacity_skips": {"type": "integer", "minimum": 0}}}}
}
