{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tactevra.dev/schemas/fixed_camera_keyboard_clearance_intake_v1.schema.json",
  "title": "Fixed-camera keyboard clearance intake v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "robot_localization_sha256", "profile_bindings_sha256", "build_snapshot_sha256", "kinematic_model_sha256", "profiles", "profile_separation_preserved", "trajectory_generated", "collision_screening_executed", "continuous_clearance_verified", "controller_commands", "hardware_commands_generated", "hardware_access", "motion_authorized", "contact_authorized", "physical_authority", "clearance_intake_sha256"],
  "properties": {
    "schema": {"const": "rocell.fixed_camera_keyboard_clearance_intake.v1"},
    "status": {"const": "READY_FOR_PROFILE_SPECIFIC_ROUTE_CONSTRUCTION"},
    "robot_localization_sha256": {"$ref": "#/$defs/digest"},
    "profile_bindings_sha256": {"$ref": "#/$defs/digest"},
    "build_snapshot_sha256": {"$ref": "#/$defs/digest"},
    "kinematic_model_sha256": {"$ref": "#/$defs/digest"},
    "profiles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["no_attachment", "stylus_attachment"],
      "properties": {
        "no_attachment": {"$ref": "#/$defs/profile"},
        "stylus_attachment": {"$ref": "#/$defs/profile"}
      }
    },
    "profile_separation_preserved": {"const": true},
    "trajectory_generated": {"const": false},
    "collision_screening_executed": {"const": false},
    "continuous_clearance_verified": {"const": false},
    "controller_commands": {"type": "array", "maxItems": 0},
    "hardware_commands_generated": {"const": 0},
    "hardware_access": {"const": false},
    "motion_authorized": {"const": false},
    "contact_authorized": {"const": false},
    "physical_authority": {"const": false},
    "clearance_intake_sha256": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "attachment_state", "robot_frame_localization_candidates_sha256", "candidate_count", "installed_collision_profile_id", "installed_collision_profile_content_sha256", "installed_collision_profile_file_sha256", "collision_contract_sha256", "clearance_policy_sha256", "measured_tcp_sha256", "route_construction_ready", "collision_screening_executed", "continuous_clearance_verified", "next_required_stage", "blockers"],
      "properties": {
        "profile": {"enum": ["no_attachment", "stylus_attachment"]},
        "attachment_state": {"enum": ["BARE_JAW", "STYLUS_INSTALLED"]},
        "robot_frame_localization_candidates_sha256": {"$ref": "#/$defs/digest"},
        "candidate_count": {"const": 46},
        "installed_collision_profile_id": {"type": "string", "minLength": 1},
        "installed_collision_profile_content_sha256": {"$ref": "#/$defs/digest"},
        "installed_collision_profile_file_sha256": {"$ref": "#/$defs/digest"},
        "collision_contract_sha256": {"$ref": "#/$defs/digest"},
        "clearance_policy_sha256": {"$ref": "#/$defs/digest"},
        "measured_tcp_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]},
        "route_construction_ready": {"const": true},
        "collision_screening_executed": {"const": false},
        "continuous_clearance_verified": {"const": false},
        "next_required_stage": {"const": "BUILD_PROFILE_SPECIFIC_TYPING_EXECUTION_PLAN_THEN_USE_TYPING_COLLISION_INTAKE_V1"},
        "blockers": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    }
  }
}
