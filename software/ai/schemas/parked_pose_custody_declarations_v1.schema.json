{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tactevra.local/schemas/parked_pose_custody_declarations_v1.schema.json",
  "title": "Externally authored parked pose custody declarations v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "scope", "campaign_sha256", "custody_review_sha256", "declarations", "declarations_sha256"],
  "properties": {
    "schema": {"const": "rocell.ai_parked_pose_custody_declarations.v1"},
    "scope": {"const": "EXTERNAL_DECLARATIONS_REQUIRING_OWNER_AUTHENTICATION"},
    "campaign_sha256": {"$ref": "#/$defs/sha256"},
    "custody_review_sha256": {"$ref": "#/$defs/sha256"},
    "declarations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sha256", "custody"],
        "properties": {
          "sha256": {"$ref": "#/$defs/sha256"},
          "custody": {"enum": ["REVIEWED_CONFIGURATION", "REVIEWED_SOFTWARE_ARTIFACT", "SYNTHETIC_RETAINED", "PHYSICAL_RETAINED_ORIGINAL", "AUTHORIZATION_RECORD"]}
        }
      }
    },
    "declarations_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
