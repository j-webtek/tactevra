{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tactevra.local/schemas/residual_obstruction_v3_renderer_lineage_v1.schema.json",
  "title": "Residual obstruction v3 renderer lineage",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "scope", "admission_receipt_sha256", "admission_file_sha256", "fixture_file_sha256", "fixture_bundle_sha256", "target_catalog_sha256", "shard_count", "observation_count", "shards", "hardware_writes", "physical_movements", "physical_authority", "limitations", "lineage_sha256"],
  "properties": {
    "schema": {"const": "tactevra.ai_residual_obstruction_v3_renderer_lineage.v1"},
    "scope": {"const": "SYNTHETIC_ISAAC_RENDERER_LINEAGE_NO_QUALIFICATION"},
    "admission_receipt_sha256": {"$ref": "#/$defs/hash"},
    "admission_file_sha256": {"$ref": "#/$defs/hash"},
    "fixture_file_sha256": {"$ref": "#/$defs/hash"},
    "fixture_bundle_sha256": {"$ref": "#/$defs/hash"},
    "target_catalog_sha256": {"$ref": "#/$defs/hash"},
    "shard_count": {"const": 19},
    "observation_count": {"const": 43200},
    "shards": {
      "type": "array",
      "minItems": 19,
      "maxItems": 19,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target_start", "target_count", "observation_count", "manifest_file_sha256", "dataset_sha256", "renderer_commit", "renderer_sha256"],
        "properties": {
          "target_start": {"type": "integer", "minimum": 0, "maximum": 74},
          "target_count": {"type": "integer", "minimum": 1, "maximum": 4},
          "observation_count": {"type": "integer", "minimum": 576, "maximum": 2304},
          "manifest_file_sha256": {"$ref": "#/$defs/hash"},
          "dataset_sha256": {"$ref": "#/$defs/hash"},
          "renderer_commit": {"$ref": "#/$defs/gitCommit"},
          "renderer_sha256": {"$ref": "#/$defs/hash"}
        }
      }
    },
    "hardware_writes": {"const": 0},
    "physical_movements": {"const": 0},
    "physical_authority": {"const": false},
    "limitations": {"type": "array", "minItems": 3, "items": {"type": "string", "minLength": 1}},
    "lineage_sha256": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
  }
}
