{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tactevra.local/schemas/residual_obstruction_v3_renderer_smoke_v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "scope", "fixture_file_sha256", "fixture_bundle_sha256", "renderer_sha256", "successful_smoke", "preserved_failures", "campaign_complete", "training_started", "evaluation_opened", "hardware_writes", "physical_movements", "physical_authority", "limitations", "report_sha256"],
  "properties": {
    "schema": {"const": "tactevra.ai_residual_obstruction_v3_renderer_smoke.v1"},
    "scope": {"const": "SYNTHETIC_ISAAC_PARTIAL_SMOKE_NO_QUALIFICATION"},
    "fixture_file_sha256": {"$ref": "#/$defs/sha256"},
    "fixture_bundle_sha256": {"$ref": "#/$defs/sha256"},
    "renderer_sha256": {"$ref": "#/$defs/sha256"},
    "successful_smoke": {"type": "object", "required": ["manifest_file_sha256", "dataset_sha256", "scene_count", "target_start", "target_count", "appearance_count", "variant_count", "observation_count", "unique_rgb_count", "file_count", "total_bytes", "overlap_ranges"], "properties": {"manifest_file_sha256": {"$ref": "#/$defs/sha256"}, "dataset_sha256": {"$ref": "#/$defs/sha256"}, "scene_count": {"const": 1}, "target_start": {"const": 0}, "target_count": {"const": 4}, "appearance_count": {"const": 4}, "variant_count": {"const": 12}, "observation_count": {"const": 192}, "unique_rgb_count": {"const": 192}, "file_count": {"const": 193}, "total_bytes": {"type": "integer", "minimum": 1}, "overlap_ranges": {"type": "object"}}, "additionalProperties": false},
    "preserved_failures": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["run_id", "failure"], "properties": {"run_id": {"type": "string"}, "failure": {"type": "string"}}, "additionalProperties": false}},
    "campaign_complete": {"const": false},
    "training_started": {"const": false},
    "evaluation_opened": {"const": false},
    "hardware_writes": {"const": 0},
    "physical_movements": {"const": 0},
    "physical_authority": {"const": false},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "report_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
