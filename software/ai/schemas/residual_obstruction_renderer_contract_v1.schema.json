{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tactevra.local/schemas/residual_obstruction_renderer_contract_v1.schema.json",
  "title": "Residual obstruction renderer contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "scope", "fixture_file_sha256", "fixture_bundle_sha256",
    "source_manifest_file_sha256", "source_corpus_sha256", "target_catalog_sha256",
    "base_scene", "warp_policy", "raster_policy", "admission",
    "evaluation_group_present", "images_generated", "hardware_writes",
    "physical_movements", "physical_authority", "limitations", "contract_sha256"
  ],
  "properties": {
    "schema": {"const": "tactevra.ai_residual_obstruction_renderer_contract.v1"},
    "scope": {"const": "SYNTHETIC_RENDERER_BINDING_NO_QUALIFICATION"},
    "fixture_file_sha256": {"$ref": "#/$defs/sha256"},
    "fixture_bundle_sha256": {"$ref": "#/$defs/sha256"},
    "source_manifest_file_sha256": {"$ref": "#/$defs/sha256"},
    "source_corpus_sha256": {"$ref": "#/$defs/sha256"},
    "target_catalog_sha256": {"$ref": "#/$defs/sha256"},
    "base_scene": {
      "type": "object", "additionalProperties": false,
      "required": ["sample_id", "pose_id", "image_path", "image_sha256", "image_bytes", "image_size_px", "ordered_target_identity_sha256", "target_count"],
      "properties": {
        "sample_id": {"const": "hover_t__nominal"}, "pose_id": {"const": "hover_t"},
        "image_path": {"type": "string", "minLength": 1}, "image_sha256": {"$ref": "#/$defs/sha256"},
        "image_bytes": {"type": "integer", "minimum": 1}, "image_size_px": {"const": [1920, 1080]},
        "ordered_target_identity_sha256": {"$ref": "#/$defs/sha256"}, "target_count": {"const": 75}
      }
    },
    "warp_policy": {"type": "object", "required": ["algorithm", "target_geometry_uses_same_affine"]},
    "raster_policy": {"type": "object", "required": ["output_format", "changed_pixel_definition", "overlap_definition"]},
    "admission": {"type": "object"},
    "evaluation_group_present": {"const": false},
    "images_generated": {"const": false},
    "hardware_writes": {"const": 0},
    "physical_movements": {"const": 0},
    "physical_authority": {"const": false},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "contract_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
