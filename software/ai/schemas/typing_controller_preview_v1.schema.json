{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tactevra.local/schemas/typing_controller_preview_v1.schema.json",
  "title": "RoCell typing controller preview v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "status", "request_id", "action_index", "target_id",
    "bindings", "qualification_sha256", "source_sample_sha256",
    "command_count", "commands", "ordered_wire_sha256",
    "dispatch_intent_sha256", "acknowledgement_requirements",
    "action_deadline_monotonic_ns", "permit_consumed", "transport_opened",
    "transport_write_count", "submitted_bytes", "automatic_retry_allowed",
    "hardware_access", "physical_authority", "typing_controller_preview_sha256"
  ],
  "properties": {
    "schema": {"const": "rocell.typing_controller_preview.v1"},
    "status": {"const": "ZERO_WRITE_T102_ACTION_PREVIEW"},
    "request_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "action_index": {"type": "integer", "minimum": 0, "maximum": 63},
    "target_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rolling_horizon_sha256", "current_action_sha256", "schedule_sha256",
        "dynamics_profile_sha256", "configuration_epoch_sha256",
        "observed_start_state_sha256", "controller_session_id",
        "collision_qualification_sha256", "execution_envelope_sha256",
        "execution_permit_sha256", "encoding_profile_sha256"
      ],
      "properties": {
        "rolling_horizon_sha256": {"$ref": "#/$defs/sha256"},
        "current_action_sha256": {"$ref": "#/$defs/sha256"},
        "schedule_sha256": {"$ref": "#/$defs/sha256"},
        "dynamics_profile_sha256": {"$ref": "#/$defs/sha256"},
        "configuration_epoch_sha256": {"$ref": "#/$defs/sha256"},
        "observed_start_state_sha256": {"$ref": "#/$defs/sha256"},
        "controller_session_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "collision_qualification_sha256": {"$ref": "#/$defs/sha256"},
        "execution_envelope_sha256": {"$ref": "#/$defs/sha256"},
        "execution_permit_sha256": {"$ref": "#/$defs/sha256"},
        "encoding_profile_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "qualification_sha256": {"$ref": "#/$defs/sha256"},
    "source_sample_sha256": {"$ref": "#/$defs/sha256"},
    "command_count": {"type": "integer", "minimum": 1, "maximum": 4095},
    "commands": {
      "type": "array", "minItems": 1, "maxItems": 4095,
      "items": {"$ref": "#/$defs/command"}
    },
    "ordered_wire_sha256": {"$ref": "#/$defs/sha256"},
    "dispatch_intent_sha256": {"$ref": "#/$defs/sha256"},
    "acknowledgement_requirements": {
      "type": "object", "additionalProperties": false,
      "required": [
        "t102_acknowledgement", "required_feedback_request_type",
        "required_feedback_response_type", "feedback_required_after_final_waypoint",
        "feedback_deadline_monotonic_ns", "completion_requires_correlated_feedback"
      ],
      "properties": {
        "t102_acknowledgement": {"const": "OPTIONAL_NOT_ASSUMED"},
        "required_feedback_request_type": {"const": 105},
        "required_feedback_response_type": {"const": 1051},
        "feedback_required_after_final_waypoint": {"const": true},
        "feedback_deadline_monotonic_ns": {"type": "integer", "minimum": 1},
        "completion_requires_correlated_feedback": {"const": true}
      }
    },
    "action_deadline_monotonic_ns": {"type": "integer", "minimum": 1},
    "permit_consumed": {"const": false},
    "transport_opened": {"const": false},
    "transport_write_count": {"const": 0},
    "submitted_bytes": {"const": []},
    "automatic_retry_allowed": {"const": false},
    "hardware_access": {"const": false},
    "physical_authority": {"const": false},
    "typing_controller_preview_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "command": {
      "type": "object", "additionalProperties": false,
      "required": [
        "ordinal", "sample_sequence", "phase", "action_index", "target_id",
        "time_from_action_start_ns", "scheduled_dispatch_monotonic_ns",
        "message", "payload_utf8", "payload_bytes", "payload_sha256"
      ],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 0},
        "sample_sequence": {"type": "integer", "minimum": 1},
        "phase": {"type": "string", "minLength": 1},
        "action_index": {"type": "integer", "minimum": 0, "maximum": 63},
        "target_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "time_from_action_start_ns": {"type": "integer", "minimum": 1},
        "scheduled_dispatch_monotonic_ns": {"type": "integer", "minimum": 1},
        "message": {
          "type": "object", "additionalProperties": false,
          "required": ["T", "base", "shoulder", "elbow", "wrist", "roll", "hand", "spd", "acc"],
          "properties": {
            "T": {"const": 102},
            "base": {"type": "number"}, "shoulder": {"type": "number"},
            "elbow": {"type": "number"}, "wrist": {"type": "number"},
            "roll": {"type": "number"}, "hand": {"type": "number"},
            "spd": {"type": "integer", "minimum": 1, "maximum": 65535},
            "acc": {"type": "integer", "minimum": 1, "maximum": 255}
          }
        },
        "payload_utf8": {"type": "string", "minLength": 2},
        "payload_bytes": {"type": "integer", "minimum": 2},
        "payload_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
