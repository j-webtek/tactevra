{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tactevra.local/schemas/typing_exact_ik_cache_benchmark_v1.schema.json",
  "title": "TypingExactIkCacheBenchmarkV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "report_id", "evidence_class", "environment", "sample_count", "samples", "summaries", "cache_totals", "semantic_equivalence", "invalidation_results", "decision_hashes_unchanged", "cache_used_for_admission", "timing_used_for_admission", "performance_authority", "controller_opened", "transport_opened", "controller_commands", "hardware_writes", "physical_movements", "physical_authority", "report_sha256"],
  "properties": {
    "schema": {"const": "rocell.typing_exact_ik_cache_benchmark.v1"},
    "report_id": {"type": "string", "minLength": 1, "maxLength": 192},
    "evidence_class": {"const": "HOST_MEASURED_OFFLINE"},
    "environment": {"type": "object"},
    "sample_count": {"type": "integer", "minimum": 40, "maximum": 4000},
    "samples": {"type": "array", "minItems": 40, "maxItems": 4000, "items": {"$ref": "#/$defs/sample"}},
    "summaries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["CACHE_DISABLED", "CACHE_COLD", "CACHE_WARM", "CACHE_CAPACITY_ONE", "warm_p50_reduction_ns", "warm_p95_reduction_ns", "cold_p50_change_ns", "capacity_one_p50_change_ns"],
      "properties": {
        "CACHE_DISABLED": {"$ref": "#/$defs/distribution"},
        "CACHE_COLD": {"$ref": "#/$defs/distribution"},
        "CACHE_WARM": {"$ref": "#/$defs/distribution"},
        "CACHE_CAPACITY_ONE": {"$ref": "#/$defs/distribution"},
        "warm_p50_reduction_ns": {"type": "integer"},
        "warm_p95_reduction_ns": {"type": "integer"},
        "cold_p50_change_ns": {"type": "integer"},
        "capacity_one_p50_change_ns": {"type": "integer"}
      }
    },
    "cache_totals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["CACHE_DISABLED", "CACHE_COLD", "CACHE_WARM", "CACHE_CAPACITY_ONE"],
      "properties": {
        "CACHE_DISABLED": {"$ref": "#/$defs/counters"},
        "CACHE_COLD": {"$ref": "#/$defs/counters"},
        "CACHE_WARM": {"$ref": "#/$defs/counters"},
        "CACHE_CAPACITY_ONE": {"$ref": "#/$defs/counters"}
      }
    },
    "semantic_equivalence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receipt_sha256", "stage_hashes_sha256", "all_outputs_identical"],
      "properties": {
        "receipt_sha256": {"$ref": "#/$defs/sha256"},
        "stage_hashes_sha256": {"$ref": "#/$defs/sha256"},
        "all_outputs_identical": {"const": true}
      }
    },
    "invalidation_results": {"const": [
      {"case": "EXPLICIT_INVALIDATION", "status": "BLOCKED"},
      {"case": "CONTEXT_RELOAD", "status": "BLOCKED"},
      {"case": "SERVICE_RESTART", "status": "BLOCKED"},
      {"case": "CROSSED_CONTEXT", "status": "BLOCKED"},
      {"case": "INTEGRITY_CORRUPTION", "status": "BLOCKED"},
      {"case": "UNMANAGED_CACHE", "status": "BLOCKED"}
    ]},
    "decision_hashes_unchanged": {"const": true},
    "cache_used_for_admission": {"const": false},
    "timing_used_for_admission": {"const": false},
    "performance_authority": {"const": false},
    "controller_opened": {"const": false},
    "transport_opened": {"const": false},
    "controller_commands": {"const": []},
    "hardware_writes": {"const": 0},
    "physical_movements": {"const": 0},
    "physical_authority": {"const": false},
    "report_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "path", "duration_ns", "receipt_sha256", "stage_hashes_sha256", "lookups", "hits", "misses", "stores", "capacity_skips"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 0},
        "path": {"enum": ["CACHE_DISABLED", "CACHE_COLD", "CACHE_WARM", "CACHE_CAPACITY_ONE"]},
        "duration_ns": {"type": "integer", "minimum": 0},
        "receipt_sha256": {"$ref": "#/$defs/sha256"},
        "stage_hashes_sha256": {"$ref": "#/$defs/sha256"},
        "lookups": {"type": "integer", "minimum": 0},
        "hits": {"type": "integer", "minimum": 0},
        "misses": {"type": "integer", "minimum": 0},
        "stores": {"type": "integer", "minimum": 0},
        "capacity_skips": {"type": "integer", "minimum": 0}
      }
    },
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "minimum_ns", "p50_ns", "p95_ns", "p99_ns", "maximum_ns"],
      "properties": {
        "count": {"type": "integer", "minimum": 10},
        "minimum_ns": {"type": "integer", "minimum": 0},
        "p50_ns": {"type": "integer", "minimum": 0},
        "p95_ns": {"type": "integer", "minimum": 0},
        "p99_ns": {"oneOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
        "maximum_ns": {"type": "integer", "minimum": 0}
      }
    },
    "counters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lookups", "hits", "misses", "stores", "capacity_skips"],
      "properties": {
        "lookups": {"type": "integer", "minimum": 0},
        "hits": {"type": "integer", "minimum": 0},
        "misses": {"type": "integer", "minimum": 0},
        "stores": {"type": "integer", "minimum": 0},
        "capacity_skips": {"type": "integer", "minimum": 0}
      }
    }
  }
}
