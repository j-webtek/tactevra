{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tactevra.local/schemas/residual_obstruction_v5_4_fixture_audit_v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "scope", "status", "source_commit", "fixture_file_sha256", "fixture_bundle_sha256", "source_file_sha256", "rotation_metrics", "development_support", "power_interpretation_present", "training_development_renderer_implementation_may_begin", "evaluation_render_authorized", "images_generated", "hardware_writes", "physical_movements", "physical_authority", "limitations", "report_sha256"],
  "properties": {
    "schema": {"const": "tactevra.ai_residual_obstruction_v5_4_fixture_audit.v1"},
    "scope": {"const": "INDEPENDENT_FIXTURE_IDENTITY_AND_COUNT_AUDIT_NO_RENDER"},
    "status": {"const": "PASS_FIXTURE_READY_FOR_TRAINING_DEVELOPMENT_RENDERER_IMPLEMENTATION"},
    "source_commit": {"$ref": "#/$defs/commit"},
    "fixture_file_sha256": {"$ref": "#/$defs/sha"},
    "fixture_bundle_sha256": {"$ref": "#/$defs/sha"},
    "source_file_sha256": {"type": "object", "additionalProperties": {"$ref": "#/$defs/sha"}},
    "rotation_metrics": {
      "type": "object", "additionalProperties": false,
      "required": ["scene_count", "unique_seed_count", "targets_per_scene", "target_count", "targets_at_35_scenes", "targets_at_36_scenes", "mixed_device_scene_count", "evaluation_observation_identities"],
      "properties": {
        "scene_count": {"const": 224}, "unique_seed_count": {"const": 224},
        "targets_per_scene": {"const": 12}, "target_count": {"const": 75},
        "targets_at_35_scenes": {"const": 12}, "targets_at_36_scenes": {"const": 63},
        "mixed_device_scene_count": {"const": 224},
        "evaluation_observation_identities": {"const": 96768}
      }
    },
    "development_support": {"type": "object", "required": ["per_target", "aggregate_cable_abstain_rows", "aggregate_dark_cable_abstain_rows", "aggregate_dark_boundary_visible_rows", "candidate_count", "same_rows_for_every_candidate", "adequacy"]},
    "power_interpretation_present": {"const": "POWER_IS_PROBABILITY_OF_PROVING_THE_SAFETY_BOUNDS_IF_TRUE_RATES_EQUAL_THE_ASSUMED_RATES_NOT_A_PREDICTION_THE_MODEL_WILL_PASS"},
    "training_development_renderer_implementation_may_begin": {"const": true},
    "evaluation_render_authorized": {"const": false},
    "images_generated": {"const": false},
    "hardware_writes": {"const": 0},
    "physical_movements": {"const": 0},
    "physical_authority": {"const": false},
    "limitations": {"type": "array", "minItems": 4, "items": {"type": "string", "minLength": 1}},
    "report_sha256": {"$ref": "#/$defs/sha"}
  },
  "$defs": {
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
