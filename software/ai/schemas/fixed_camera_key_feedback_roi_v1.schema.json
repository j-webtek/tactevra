{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tactevra.local/schemas/fixed_camera_key_feedback_roi_v1.schema.json",
  "title": "Fixed camera key feedback ROI v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "status", "registration_input_sha256", "calibration_sha256",
    "profile_sha256", "source_frame_sha256", "source_frame_bytes_verified",
    "profile", "camera_width_px", "camera_height_px", "keyboard_corner_order",
    "keyboard_polygon_pixel_xy", "local_keyboard_to_pixel_homography",
    "search_margin_px", "key_feedback_windows", "key_feedback_window_count",
    "image_space_feedback_windows_ready",
    "independent_key_center_observations_present",
    "individual_key_localization_ready", "board_space_motion_targets_emitted",
    "board_to_robot_transform_verified", "physical_clearance_verified",
    "contact_authorized", "motion_authorized", "blockers", "limitations"
  ],
  "properties": {
    "schema": {"const": "rocell.fixed_camera_key_feedback_roi.v1"},
    "status": {"const": "IMAGE_SEARCH_WINDOWS_ONLY_NOT_MOTION_AUTHORITY"},
    "registration_input_sha256": {"$ref": "#/$defs/digest"},
    "calibration_sha256": {"$ref": "#/$defs/digest"},
    "profile_sha256": {"$ref": "#/$defs/digest"},
    "source_frame_sha256": {"$ref": "#/$defs/digest"},
    "source_frame_bytes_verified": {"type": "boolean"},
    "profile": {"enum": ["no_attachment", "stylus_attachment"]},
    "camera_width_px": {"const": 1920},
    "camera_height_px": {"const": 1080},
    "keyboard_corner_order": {
      "const": ["front_left", "front_right", "rear_right", "rear_left"]
    },
    "keyboard_polygon_pixel_xy": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": {"$ref": "#/$defs/xy"}
    },
    "local_keyboard_to_pixel_homography": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {
        "type": "array", "minItems": 3, "maxItems": 3,
        "items": {"type": "number"}
      }
    },
    "search_margin_px": {"type": "number", "minimum": 0},
    "key_feedback_windows": {
      "type": "object", "minProperties": 46, "maxProperties": 46,
      "additionalProperties": {"$ref": "#/$defs/window"}
    },
    "key_feedback_window_count": {"const": 46},
    "image_space_feedback_windows_ready": {"type": "boolean"},
    "independent_key_center_observations_present": {"const": false},
    "individual_key_localization_ready": {"const": false},
    "board_space_motion_targets_emitted": {"const": false},
    "board_to_robot_transform_verified": {"const": false},
    "physical_clearance_verified": {"const": false},
    "contact_authorized": {"const": false},
    "motion_authorized": {"const": false},
    "blockers": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"enum": [
        "INDEPENDENT_KEY_CENTER_OBSERVATIONS_MISSING",
        "BOARD_SPACE_INDIVIDUAL_KEY_LIMIT_NOT_MET",
        "STYLUS_TCP_AND_CONTACT_PROFILE_MISSING",
        "TOOL_PROFILE_NOT_ADMITTED"
      ]}
    },
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "xy": {
      "type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}],
      "items": false, "minItems": 2, "maxItems": 2
    },
    "xyxy": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": {"type": "number"}
    },
    "window": {
      "type": "object", "additionalProperties": false,
      "required": ["nominal_center_pixel_xy", "nominal_key_polygon_pixel_xy", "search_rect_pixel_xyxy"],
      "properties": {
        "nominal_center_pixel_xy": {"$ref": "#/$defs/xy"},
        "nominal_key_polygon_pixel_xy": {
          "type": "array", "minItems": 4, "maxItems": 4,
          "items": {"$ref": "#/$defs/xy"}
        },
        "search_rect_pixel_xyxy": {"$ref": "#/$defs/xyxy"}
      }
    }
  }
}
