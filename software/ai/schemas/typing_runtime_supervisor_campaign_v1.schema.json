{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rocell.local/schemas/typing_runtime_supervisor_campaign_v1.schema.json",
  "title": "RoCell typing runtime supervisor campaign v1",
  "type": "object",
  "required": ["schema", "campaign_id", "environment", "reference_shadow_receipt_sha256", "case_count", "cases", "campaign_sha256"],
  "properties": {
    "schema": {"const": "rocell.typing_runtime_supervisor_campaign.v1"},
    "campaign_id": {"type": "string", "minLength": 1},
    "environment": {"type": "object"},
    "reference_shadow_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "case_count": {"const": 7},
    "cases": {"type": "array", "minItems": 7, "maxItems": 7},
    "campaign_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
