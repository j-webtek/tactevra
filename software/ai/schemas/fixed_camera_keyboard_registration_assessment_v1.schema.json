{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tactevra.local/schemas/fixed_camera_keyboard_registration_assessment_v1.schema.json",
  "title": "Fixed camera keyboard registration assessment v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "status", "input_sha256", "calibration_sha256",
    "profile_sha256", "source_frame_sha256", "source_frame_bytes_verified",
    "profile", "camera_and_board_temporal_check_passed",
    "world_tag_center_rms_error_mm", "world_tag_center_max_error_mm",
    "station_tag_center_max_drift_px", "observed_corners_board_xy_mm",
    "fitted_front_left_board_xy_mm", "fitted_yaw_deg",
    "housing_corner_rms_residual_mm", "housing_corner_max_residual_mm",
    "individual_key_localization_limit_mm",
    "nominal_key_centers_board_xy_mm",
    "keyboard_region_localization_ready", "individual_key_localization_ready",
    "actual_key_centers_measured", "board_to_robot_transform_verified",
    "physical_clearance_verified", "open_loop_contact_authorized",
    "motion_authorized", "profile_blockers", "limitations"
  ],
  "properties": {
    "schema": {"const": "rocell.fixed_camera_keyboard_registration_assessment.v1"},
    "status": {"const": "FIXED_CAMERA_REGION_ESTIMATE_NOT_MOTION_AUTHORITY"},
    "input_sha256": {"$ref": "#/$defs/digest"},
    "calibration_sha256": {"$ref": "#/$defs/digest"},
    "profile_sha256": {"$ref": "#/$defs/digest"},
    "source_frame_sha256": {"$ref": "#/$defs/digest"},
    "source_frame_bytes_verified": {"type": "boolean"},
    "profile": {"enum": ["no_attachment", "stylus_attachment"]},
    "camera_and_board_temporal_check_passed": {"const": true},
    "world_tag_center_rms_error_mm": {"type": "number", "minimum": 0},
    "world_tag_center_max_error_mm": {"type": "number", "minimum": 0},
    "station_tag_center_max_drift_px": {"type": "number", "minimum": 0},
    "observed_corners_board_xy_mm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["front_left", "front_right", "rear_right", "rear_left"],
      "properties": {
        "front_left": {"$ref": "#/$defs/xy"},
        "front_right": {"$ref": "#/$defs/xy"},
        "rear_right": {"$ref": "#/$defs/xy"},
        "rear_left": {"$ref": "#/$defs/xy"}
      }
    },
    "fitted_front_left_board_xy_mm": {"$ref": "#/$defs/xy"},
    "fitted_yaw_deg": {"type": "number"},
    "housing_corner_rms_residual_mm": {"type": "number", "minimum": 0},
    "housing_corner_max_residual_mm": {"type": "number", "minimum": 0},
    "individual_key_localization_limit_mm": {"type": "number", "exclusiveMinimum": 0},
    "nominal_key_centers_board_xy_mm": {
      "type": "object", "minProperties": 40,
      "additionalProperties": {"$ref": "#/$defs/xy"}
    },
    "keyboard_region_localization_ready": {"type": "boolean"},
    "individual_key_localization_ready": {"type": "boolean"},
    "actual_key_centers_measured": {"const": false},
    "board_to_robot_transform_verified": {"const": false},
    "physical_clearance_verified": {"const": false},
    "open_loop_contact_authorized": {"const": false},
    "motion_authorized": {"const": false},
    "profile_blockers": {
      "type": "array", "uniqueItems": true, "maxItems": 1,
      "items": {"enum": [
        "STYLUS_TCP_AND_CONTACT_PROFILE_MISSING", "TOOL_PROFILE_NOT_ADMITTED"
      ]}
    },
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "xy": {
      "type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}],
      "items": false, "minItems": 2, "maxItems": 2
    }
  }
}
