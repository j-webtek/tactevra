{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tactevra.local/schemas/residual_obstruction_successor_fixture_v5.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "scope", "status", "source_commit", "source", "sequence_amendment", "split_identities", "variants", "render_contract", "candidate_models", "training_contract", "development_gates", "end_to_end_follow_on", "images_generated", "training_started", "development_opened", "evaluation_opened", "hardware_writes", "physical_movements", "physical_authority", "limitations", "bundle_sha256"],
  "properties": {
    "schema": {"const": "tactevra.ai_residual_obstruction_successor_fixture.v5"},
    "scope": {"const": "SYNTHETIC_ISAAC_V5_PREDECLARATION_NO_QUALIFICATION"},
    "status": {"const": "FROZEN_BEFORE_RENDER"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source": {"type": "object", "required": ["remedy_file_sha256", "remedy_report_sha256", "robustness_file_sha256", "robustness_report_sha256", "v4_2_fixture_file_sha256", "v4_2_fixture_bundle_sha256", "target_catalog_sha256"]},
    "sequence_amendment": {"type": "object", "required": ["previous_rule", "owner_direction", "allowed_effect", "physical_pilot_still_required_for", "v4_2_rejection_preserved", "evaluation_remains_unrendered"]},
    "split_identities": {"type": "object", "required": ["scenes", "lighting", "obstruction_assets", "pairwise_disjoint_required", "procedural_seed_ranges"]},
    "variants": {"type": "array", "minItems": 12, "maxItems": 12, "uniqueItems": true},
    "render_contract": {"type": "object", "required": ["targets", "training_observations", "development_observations", "evaluation_observation_identities", "evaluation_images_generated", "same_obstruction_mesh_or_material_across_splits_prohibited", "arm_mask_from_perturbed_measured_state_not_ground_truth_mask"]},
    "candidate_models": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true},
    "training_contract": {"type": "object", "required": ["offline_capable", "unchanged_training_free_baseline_required", "unchanged_v4_2_checkpoint_comparison_required", "memorization_rows", "minimum_memorization_accuracy", "thresholds", "model_output_semantics"]},
    "development_gates": {"type": "object", "required": ["maximum_cable_family_missed_rate", "maximum_dark_cable_30_60_missed_rate", "minimum_every_target_auc", "minimum_linear_q05_target_auc", "minimum_linear_q05_target_quantile_margin", "hard_case_reports_required", "selection_rule", "no_passing_candidate_result"]},
    "end_to_end_follow_on": {"type": "object", "required": ["required_after_development_pass", "actual_model_motion_batch_v2_output_required", "simulated_missions", "wrong_target_contacts_allowed", "hardware_authority"]},
    "images_generated": {"const": false}, "training_started": {"const": false}, "development_opened": {"const": false}, "evaluation_opened": {"const": false},
    "hardware_writes": {"const": 0}, "physical_movements": {"const": 0}, "physical_authority": {"const": false},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "bundle_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
