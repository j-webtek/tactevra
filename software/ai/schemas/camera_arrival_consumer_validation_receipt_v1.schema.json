{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tactevra.local/schemas/camera_arrival_consumer_validation_receipt_v1.schema.json",
  "title": "Camera arrival consumer validation receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "artifact_id", "handoff_sha256", "preflight_sha256",
    "consumer_map_sha256", "sidecar_sha256", "source_sha256",
    "consumer_source", "consumer_source_sha256", "downstream_schema",
    "downstream_schema_sha256", "consumer_binding", "validator_id",
    "validator_version_sha256", "validated_at_utc", "validation_status",
    "blockers", "output_sha256", "consumer_invoked", "camera_opened",
    "controller_started", "hardware_writes", "physical_movements",
    "qualification_installed", "physical_admission_ready",
    "physical_authority", "receipt_sha256"
  ],
  "properties": {
    "schema": {"const": "rocell.camera_arrival_consumer_validation_receipt.v1"},
    "artifact_id": {"type": "string", "minLength": 1},
    "handoff_sha256": {"$ref": "#/$defs/sha256"},
    "preflight_sha256": {"$ref": "#/$defs/sha256"},
    "consumer_map_sha256": {"$ref": "#/$defs/sha256"},
    "sidecar_sha256": {"$ref": "#/$defs/sha256"},
    "source_sha256": {"$ref": "#/$defs/sha256"},
    "consumer_source": {"type": "string", "minLength": 1},
    "consumer_source_sha256": {"$ref": "#/$defs/sha256"},
    "downstream_schema": {"type": "string", "minLength": 1},
    "downstream_schema_sha256": {"$ref": "#/$defs/sha256"},
    "consumer_binding": {"type": "string", "minLength": 1},
    "validator_id": {"type": "string", "minLength": 1},
    "validator_version_sha256": {"$ref": "#/$defs/sha256"},
    "validated_at_utc": {"type": "string", "format": "date-time"},
    "validation_status": {"enum": ["PASS", "BLOCKED"]},
    "blockers": {
      "type": "array", "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "output_sha256": {
      "anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
    },
    "consumer_invoked": {"const": true},
    "camera_opened": {"const": false},
    "controller_started": {"const": false},
    "hardware_writes": {"const": 0},
    "physical_movements": {"const": 0},
    "qualification_installed": {"const": false},
    "physical_admission_ready": {"const": false},
    "physical_authority": {"const": false},
    "receipt_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
