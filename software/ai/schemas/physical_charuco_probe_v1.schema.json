{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tactevra.local/schemas/physical_charuco_probe_v1.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "scope", "status", "source_commit", "commands", "camera_class_device_count", "image_class_device_count", "camera_command_output_sha256", "image_command_output_sha256", "opencv", "tooling_smoke_board_definition", "tooling_smoke_board_definition_sha256", "tooling_smoke_board_pdf_sha256", "production_board_contract", "production_board_asset_retained", "production_board_physical_print_scale_verified", "production_board_rigid_backing_verified", "capture_count", "calibration_solved", "reprojection_error_px", "diagnostic_reprojection_target_px", "diagnostic_target_is_qualification_threshold", "blocked_reasons", "hardware_writes", "physical_movements", "physical_authority", "limitations", "report_sha256"],
  "properties": {
    "schema": {"const": "tactevra.ai_physical_charuco_probe.v1"},
    "scope": {"const": "READ_ONLY_DEVICE_AND_TOOLING_PROBE_NO_CALIBRATION"},
    "status": {"enum": ["BLOCKED", "READY_FOR_MANUAL_CAPTURE"]},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "commands": {"type": "array", "minItems": 2, "items": {"type": "string"}},
    "camera_class_device_count": {"type": "integer", "minimum": 0}, "image_class_device_count": {"type": "integer", "minimum": 0},
    "camera_command_output_sha256": {"$ref": "#/$defs/sha256"}, "image_command_output_sha256": {"$ref": "#/$defs/sha256"},
    "opencv": {"type": "object", "required": ["opencv_version", "numpy_version", "aruco_available", "generated_asset_charuco_corners"]},
    "tooling_smoke_board_definition": {"type": "object"}, "tooling_smoke_board_definition_sha256": {"$ref": "#/$defs/sha256"}, "tooling_smoke_board_pdf_sha256": {"$ref": "#/$defs/sha256"},
    "production_board_contract": {
      "type": "object", "additionalProperties": false,
      "required": ["camera_model", "native_width_px", "native_height_px", "capture_fps", "pixel_format", "dictionary", "squares_x", "squares_y", "square_length_mm", "marker_length_mm", "rigid_backing_required"],
      "properties": {
        "camera_model": {"const": "Arducam B0477"}, "native_width_px": {"const": 5472}, "native_height_px": {"const": 3648},
        "capture_fps": {"const": 4}, "pixel_format": {"const": "YUY2"}, "dictionary": {"const": "DICT_5X5_1000"},
        "squares_x": {"const": 12}, "squares_y": {"const": 9}, "square_length_mm": {"const": 30.0},
        "marker_length_mm": {"const": 22.0}, "rigid_backing_required": {"const": true}
      }
    },
    "production_board_asset_retained": {"const": false}, "production_board_physical_print_scale_verified": {"const": false}, "production_board_rigid_backing_verified": {"const": false},
    "capture_count": {"const": 0}, "calibration_solved": {"const": false},
    "reprojection_error_px": {"type": "null"}, "diagnostic_reprojection_target_px": {"const": 0.5}, "diagnostic_target_is_qualification_threshold": {"const": false},
    "blocked_reasons": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "hardware_writes": {"const": 0}, "physical_movements": {"const": 0}, "physical_authority": {"const": false},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "report_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
