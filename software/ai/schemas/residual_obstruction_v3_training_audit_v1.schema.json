{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tactevra.local/schemas/residual_obstruction_v3_training_audit_v1.schema.json",
  "title": "Residual obstruction v3 training-only causal audit",
  "type": "object",
  "required": [
    "schema", "scope", "fixture_file_sha256", "fixture_bundle_sha256",
    "admission_file_sha256", "admission_receipt_sha256", "lineage_file_sha256",
    "scorecard_file_sha256", "scorecard_result_sha256", "model_file_sha256",
    "training_count", "identity_geometry_baseline", "model_training_diagnostics",
    "memorization_test", "visual_audit", "split_audit", "checkpoint_changed",
    "threshold_changed", "development_pixels_opened", "evaluation_opened",
    "hardware_writes", "physical_movements", "physical_authority", "limitations",
    "report_sha256"
  ],
  "properties": {
    "schema": {"const": "tactevra.ai_residual_obstruction_v3_training_audit.v1"},
    "scope": {"const": "TRAINING_ONLY_CAUSAL_AUDIT_NO_QUALIFICATION"},
    "fixture_file_sha256": {"$ref": "#/$defs/sha256"},
    "fixture_bundle_sha256": {"$ref": "#/$defs/sha256"},
    "admission_file_sha256": {"$ref": "#/$defs/sha256"},
    "admission_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "lineage_file_sha256": {"$ref": "#/$defs/sha256"},
    "scorecard_file_sha256": {"$ref": "#/$defs/sha256"},
    "scorecard_result_sha256": {"$ref": "#/$defs/sha256"},
    "model_file_sha256": {"$ref": "#/$defs/sha256"},
    "training_count": {"const": 28800},
    "identity_geometry_baseline": {
      "type": "object",
      "required": ["model", "training_count", "positive_rate", "minimum_target_positive_rate", "maximum_target_positive_rate", "pooled_training_auc", "coefficient_sha256"],
      "properties": {
        "model": {"const": "RIDGE_LOGISTIC_TARGET_ONE_HOT_PLUS_NORMALIZED_GEOMETRY"},
        "training_count": {"const": 28800},
        "positive_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "minimum_target_positive_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "maximum_target_positive_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "pooled_training_auc": {"type": "number", "minimum": 0, "maximum": 1},
        "coefficient_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "model_training_diagnostics": {
      "type": "object",
      "required": ["pooled_training_auc", "locally_separable_target_count", "target_count", "minimum_target_auc", "median_target_auc", "maximum_target_auc", "worst_target_margin", "best_target_margin", "target_diagnostics", "variant_diagnostics", "training_probability_sha256"]
    },
    "memorization_test": {
      "type": "object",
      "required": ["subset_count", "visible_count", "obstruction_count", "epochs_run", "first_loss", "final_loss", "final_accuracy", "near_zero_loss_met", "memorization_accuracy_met", "subset_identity_sha256"]
    },
    "visual_audit": {
      "type": "object",
      "required": ["target_id", "row_count", "rows", "sheet_sha256", "human_review_status"],
      "properties": {
        "target_id": {"const": "keyboard:G"},
        "row_count": {"const": 24},
        "rows": {"type": "array", "minItems": 24, "maxItems": 24},
        "sheet_sha256": {"$ref": "#/$defs/sha256"},
        "human_review_status": {"const": "PENDING"}
      }
    },
    "split_audit": {
      "type": "object",
      "required": ["training_scene_ids", "development_scene_ids", "scene_identity_overlap", "training_appearance_ids", "development_appearance_ids", "appearance_identity_overlap", "observation_identity_overlap_count", "split_unit", "development_pixels_opened", "evaluation_present", "evaluation_opened"]
    },
    "checkpoint_changed": {"const": false},
    "threshold_changed": {"const": false},
    "development_pixels_opened": {"const": false},
    "evaluation_opened": {"const": false},
    "hardware_writes": {"const": 0},
    "physical_movements": {"const": 0},
    "physical_authority": {"const": false},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "report_sha256": {"$ref": "#/$defs/sha256"}
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
