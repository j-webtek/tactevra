{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tactevra.local/schemas/residual_obstruction_development_v1.schema.json",
  "title": "Residual obstruction synthetic development result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "scope", "status", "fixture_file_sha256", "fixture_bundle_sha256",
    "dataset_manifest_file_sha256", "dataset_sha256", "dataset_inventory_sha256",
    "model_sha256", "model_bytes", "training_plan", "target_id_encoding",
    "training_count", "development_count", "evaluation_count", "epoch_losses",
    "selected_threshold", "selected_measurement", "threshold_measurements",
    "development_probability_sha256", "development_identity_sha256",
    "evaluation_opened", "hardware_writes", "physical_movements",
    "physical_authority", "limitations", "result_sha256"
  ],
  "properties": {
    "schema": {"const": "tactevra.ai_residual_obstruction_development.v1"},
    "scope": {"const": "SYNTHETIC_DEVELOPMENT_ONLY_NO_QUALIFICATION"},
    "status": {"enum": ["PASSED_DEVELOPMENT_GATE", "FAILED_DEVELOPMENT_GATE"]},
    "fixture_file_sha256": {"$ref": "#/$defs/sha256"},
    "fixture_bundle_sha256": {"$ref": "#/$defs/sha256"},
    "dataset_manifest_file_sha256": {"$ref": "#/$defs/sha256"},
    "dataset_sha256": {"$ref": "#/$defs/sha256"},
    "dataset_inventory_sha256": {"$ref": "#/$defs/sha256"},
    "model_sha256": {"$ref": "#/$defs/sha256"},
    "model_bytes": {"type": "integer", "minimum": 1},
    "training_plan": {"type": "object"},
    "target_id_encoding": {"const": "SORTED_CATALOG_INDEX_NORMALIZED_0_TO_1_CONSTANT_CHANNEL"},
    "training_count": {"const": 600},
    "development_count": {"const": 600},
    "evaluation_count": {"const": 0},
    "epoch_losses": {
      "type": "array", "minItems": 12, "maxItems": 12,
      "items": {"type": "number", "minimum": 0}
    },
    "selected_threshold": {"type": ["number", "null"], "minimum": 0.05, "maximum": 0.95},
    "selected_measurement": {"oneOf": [{"$ref": "#/$defs/measurement"}, {"type": "null"}]},
    "threshold_measurements": {
      "type": "array", "minItems": 19, "maxItems": 19,
      "items": {"$ref": "#/$defs/measurement"}
    },
    "development_probability_sha256": {"$ref": "#/$defs/sha256"},
    "development_identity_sha256": {"$ref": "#/$defs/sha256"},
    "evaluation_opened": {"const": false},
    "hardware_writes": {"const": 0},
    "physical_movements": {"const": 0},
    "physical_authority": {"const": false},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "result_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "threshold", "missed_obstructions", "obstruction_count",
        "missed_obstruction_rate", "missed_obstruction_cluster_upper",
        "visible_false_stops", "visible_count", "visible_false_stop_rate",
        "visible_false_stop_cluster_upper", "gate_met"
      ],
      "properties": {
        "threshold": {"type": "number", "minimum": 0.05, "maximum": 0.95},
        "missed_obstructions": {"type": "integer", "minimum": 0},
        "obstruction_count": {"const": 450},
        "missed_obstruction_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "missed_obstruction_cluster_upper": {"type": "number", "minimum": 0, "maximum": 1},
        "visible_false_stops": {"type": "integer", "minimum": 0},
        "visible_count": {"const": 150},
        "visible_false_stop_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "visible_false_stop_cluster_upper": {"type": "number", "minimum": 0, "maximum": 1},
        "gate_met": {"type": "boolean"}
      }
    }
  }
}
