{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rocell.local/schemas/external_native_t102_authority_v1.schema.json",
  "title": "RoCell externally issued native T102 authority v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "scope", "authority_id", "approval_record_sha256", "review_sha256", "claim_sha256", "frame_sha256", "wire_bytes_sha256", "endpoint_sha256", "writer_instance_id", "controller_session_id", "configuration_epoch_sha256", "encoding_profile_sha256", "issued_monotonic_ns", "expires_monotonic_ns", "maximum_uses", "automatic_retry_allowed", "issuer_key_id", "detached_signature", "signed_payload_sha256"],
  "properties": {
    "schema": {"const": "rocell.external_native_t102_authority.v1"},
    "scope": {"const": "NATIVE_T102_SINGLE_ACTION_PHYSICAL"},
    "authority_id": {"$ref": "#/$defs/identifier"},
    "approval_record_sha256": {"$ref": "#/$defs/hash"},
    "review_sha256": {"$ref": "#/$defs/hash"},
    "claim_sha256": {"$ref": "#/$defs/hash"},
    "frame_sha256": {"$ref": "#/$defs/hash"},
    "wire_bytes_sha256": {"$ref": "#/$defs/hash"},
    "endpoint_sha256": {"$ref": "#/$defs/hash"},
    "writer_instance_id": {"$ref": "#/$defs/identifier"},
    "controller_session_id": {"$ref": "#/$defs/identifier"},
    "configuration_epoch_sha256": {"$ref": "#/$defs/hash"},
    "encoding_profile_sha256": {"$ref": "#/$defs/hash"},
    "issued_monotonic_ns": {"type": "integer", "minimum": 1},
    "expires_monotonic_ns": {"type": "integer", "minimum": 1},
    "maximum_uses": {"const": 1},
    "automatic_retry_allowed": {"const": false},
    "issuer_key_id": {"$ref": "#/$defs/identifier"},
    "detached_signature": {"type": "string", "minLength": 16, "maxLength": 4096, "pattern": "^[!-~]+$"},
    "signed_payload_sha256": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}
  }
}
